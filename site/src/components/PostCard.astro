---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { isMembersOnly } from "../lib/visibility";
import type { PostTerms } from "../lib/terms";
import Terms from "./Terms.astro";
import Icon from "./brand/Icon.astro";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	priority?: boolean;
	terms?: PostTerms;
}
const { post, priority = false, terms } = Astro.props;

const href = `/posts/${post.id}`;
const familyOnly = isMembersOnly(post);
const author = post.data.bylines?.[0]?.byline?.displayName ?? post.data.byline?.displayName ?? "The Bridgewaters";
const published = post.data.publishedAt ?? post.data.createdAt;
const when = published
	? new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(
			-Math.max(0, Math.round((Date.now() - new Date(published).getTime()) / 86_400_000)),
			"day",
		)
	: "";
---

<article class="post">
	<header class="post__head">
		<span class="post__who">
			<span class="post__author">{author}</span>
			{published && <time class="bw-mono" datetime={new Date(published).toISOString()}>{when}</time>}
		</span>
		{familyOnly && <span class="bw-status post__badge" data-state="private" title="Only signed-in family can see this post">family only</span>}
	</header>

	<a href={href} class="post__link">
		<h2 class="post__title" {...post.edit.title}>{post.data.title}</h2>
		{post.data.excerpt && <p class="post__excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>}
	</a>

	{
		post.data.featured_image && (
			<a href={href} class="post__media" tabindex="-1" aria-hidden="true" {...post.edit.featured_image}>
				<Image image={post.data.featured_image} sizes="(min-width: 720px) 656px, 100vw" priority={priority} />
			</a>
		)
	}

	{terms && (terms.category.length > 0 || terms.tag.length > 0) && (
		<div class="post__terms">
			<Terms terms={terms} />
		</div>
	)}

	<footer class="post__foot">
		<a href={`${href}#comments`}>Comments</a>
		<a href={href} class="post__more">Read more <Icon name="arrow-right" size={16} /></a>
	</footer>
</article>

<style>
	/* A feed is a column of posts separated by hairlines, not a stack of cards. */
	.post {
		padding: var(--space-5) 0;
		border-bottom: var(--hairline) solid var(--line);
	}
	.post__head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.post__who {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 var(--space-3);
	}
	.post__author {
		font-weight: 500;
	}
	.post__who time {
		color: var(--comment);
		font-size: 12.5px;
		line-height: 18px;
	}
	.post__badge {
		margin-left: auto;
	}
	.post__link {
		display: block;
		color: var(--ink);
		text-decoration: none;
		padding: var(--space-2) 0 var(--space-3);
	}
	.post__link:hover .post__title {
		color: var(--teal);
		text-decoration: underline;
		text-decoration-thickness: var(--hairline);
		text-underline-offset: 4px;
	}
	.post__excerpt {
		margin-top: var(--space-1);
		color: var(--soft);
		max-width: var(--measure);
	}
	.post__media :global(img) {
		width: 100%;
		max-height: 70vh;
		object-fit: cover;
		border-radius: var(--radius-md);
	}
	.post__terms {
		margin-top: var(--space-3);
	}
	.post__foot {
		display: flex;
		justify-content: space-between;
		margin-top: var(--space-3);
		font-size: 14px;
		line-height: 22px;
	}
	.post__foot a {
		text-decoration: none;
	}
	.post__foot a:hover {
		text-decoration: underline;
	}
	.post__more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
</style>
