---
import { decodeSlug, getEmDashEntry } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getFamilyUser } from "../../lib/auth";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry }, user] = await Promise.all([getEmDashEntry("pages", slug), getFamilyUser(Astro.request)]);
if (!entry) return Astro.rewrite("/404");

Astro.response.headers.set("Cache-Control", "private, no-store");

const data = entry.data as Record<string, any>;
const page = createPublicPageContext({
	Astro,
	kind: "content",
	pageType: "website",
	title: data.title,
	content: { collection: "pages", id: data.id, slug },
});
---

<Base title={data.title} user={user} page={page} path={[slug]}>
	<article class="article reading">
		<div class="bw-pagehead">
			<div class="bw-pagehead__text">
				<h1 {...entry.edit.title}>{data.title}</h1>
			</div>
		</div>
		{
			data.featured_image && (
				<div class="article__media" {...entry.edit.featured_image}>
					<Image image={data.featured_image} sizes="(min-width: 720px) 720px, 100vw" priority />
				</div>
			)
		}
		<div class="prose">
			<PortableText value={data.content} />
		</div>
	</article>
</Base>
