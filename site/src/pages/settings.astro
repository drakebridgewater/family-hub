---
import Base from "../layouts/Base.astro";
import { getFamilyUser } from "../lib/auth";
import { servicesFor, resolveIcon } from "../lib/services";
import { maxScheduleDays, scheduleEnabled } from "../lib/calendar";
import { DAY_CHOICES, getPrefs, savePrefs, type HomeTab } from "../lib/prefs";

const user = await getFamilyUser(Astro.request);
if (!user) return Astro.redirect("/login", 302);

Astro.response.headers.set("Cache-Control", "private, no-store");

const sections = await servicesFor(user);
const allUrls = sections.flatMap((s) => s.services.map((svc) => svc.url));
const showSchedule = scheduleEnabled();
const dayChoices = DAY_CHOICES.filter((d) => d <= maxScheduleDays());

if (Astro.request.method === "POST") {
	// Same-origin form posts only (the page is public, so guard against CSRF).
	const siteOrigin = new URL(process.env.EMDASH_SITE_URL ?? Astro.url.origin).origin;
	const origin = Astro.request.headers.get("origin");
	if (origin !== siteOrigin) return new Response("Forbidden", { status: 403 });

	const form = await Astro.request.formData();
	const shown = new Set(form.getAll("show").map(String));
	await savePrefs(user.username, {
		hidden: allUrls.filter((url) => !shown.has(url)),
		days: Number(form.get("days")),
		startTab: String(form.get("startTab")) as HomeTab,
	});
	return Astro.redirect("/", 303);
}

const prefs = await getPrefs(user.username);
const hidden = new Set(prefs.hidden);
const tabChoices: Array<{ id: HomeTab; label: string }> = [
	{ id: "feed", label: "Feed" },
	...(showSchedule ? [{ id: "schedule" as const, label: "Schedule" }] : []),
	{ id: "apps", label: "Apps" },
];
const dayLabel = (d: number) => (d === 1 ? "Today" : `${d} days`);
---

<Base title="Customize" user={user}>
	<a href="/" class="back">← Home</a>
	<h1 class="title">Customize your home</h1>
	<p class="sub">These settings are just for you, {user.name.split(" ")[0]}, and follow you to any device.</p>

	<form method="post" class="form">
		<fieldset class="card group" id="start">
			<legend>Open to</legend>
			<p class="hint">Which tab you land on when you open the hub on your phone.</p>
			<div class="chips">
				{
					tabChoices.map((t) => (
						<label class="chip">
							<input type="radio" name="startTab" value={t.id} checked={prefs.startTab === t.id} />
							<span>{t.label}</span>
						</label>
					))
				}
			</div>
		</fieldset>

		{
			showSchedule && (
				<fieldset class="card group" id="days">
					<legend>Calendar</legend>
					<p class="hint">How far ahead "Coming up" shows.</p>
					<div class="chips">
						{dayChoices.map((d) => (
							<label class="chip">
								<input type="radio" name="days" value={d} checked={prefs.days === d} />
								<span>{dayLabel(d)}</span>
							</label>
						))}
					</div>
				</fieldset>
			)
		}
		{!showSchedule && <input type="hidden" name="days" value={prefs.days} />}

		<fieldset class="card group" id="apps">
			<legend>Apps</legend>
			<p class="hint">Turn off the ones you don't use. You can turn them back on any time.</p>
			{
				sections.map((section) => (
					<div class="apps-section">
						{section.title && <h2 class="apps-section__title">{section.title}</h2>}
						<ul class="apps" role="list">
							{section.services.map((svc) => {
								const icon = resolveIcon(svc.icon);
								return (
									<li>
										<label class="app">
											<span class="app__icon" aria-hidden="true">
												{icon.kind === "img" ? <img src={icon.value} alt="" width="28" height="28" /> : icon.value}
											</span>
											<span class="app__name">{svc.name}</span>
											<input
												class="switch"
												type="checkbox"
												name="show"
												value={svc.url}
												checked={!hidden.has(svc.url)}
												aria-label={`Show ${svc.name}`}
											/>
										</label>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</fieldset>

		<div class="actions">
			<button type="submit" class="btn">Save</button>
			<a href="/" class="btn btn--ghost">Cancel</a>
		</div>
	</form>
</Base>

<style>
	.back {
		display: inline-block;
		margin-top: 12px;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9rem;
	}
	.title {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 6vw, 2rem);
		line-height: 1.15;
		margin: 8px 0 0;
	}
	.sub {
		margin: 4px 0 0;
		color: var(--muted);
	}
	.form {
		display: grid;
		gap: 16px;
		margin-top: 20px;
	}
	.group {
		margin: 0;
		padding: 16px;
		min-width: 0;
	}
	legend {
		float: left;
		width: 100%;
		padding: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 600;
	}
	.hint {
		clear: both;
		margin: 2px 0 12px;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.chip span {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 16px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--surface-2);
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
	}
	.chip input:checked + span {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}
	.chip input:focus-visible + span {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}
	.apps-section + .apps-section {
		margin-top: 14px;
	}
	.apps-section__title {
		margin: 0 0 4px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.apps {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.apps li + li {
		border-top: 1px solid var(--line);
	}
	.app {
		display: grid;
		grid-template-columns: 36px 1fr auto;
		align-items: center;
		gap: 12px;
		min-height: 52px;
		cursor: pointer;
	}
	.app__icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		display: grid;
		place-items: center;
		background: var(--surface-2);
		font-size: 1.2rem;
	}
	.app__icon img {
		width: 24px;
		height: 24px;
		object-fit: contain;
	}
	.app__name {
		font-weight: 600;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	/* iOS-style toggle */
	.switch {
		appearance: none;
		margin: 0;
		width: 48px;
		height: 28px;
		border-radius: 999px;
		background: var(--line);
		position: relative;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.switch::after {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
		transition: transform 0.15s ease;
	}
	.switch:checked {
		background: var(--accent);
	}
	.switch:checked::after {
		transform: translateX(20px);
	}
	.actions {
		display: flex;
		gap: 10px;
		position: sticky;
		bottom: 0;
		padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
		background: linear-gradient(transparent, var(--bg) 30%);
	}
	.actions .btn {
		flex: 1;
	}
	@media (min-width: 560px) {
		.actions .btn {
			flex: 0 0 auto;
		}
	}
</style>
