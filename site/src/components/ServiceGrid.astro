---
import type { AppView, MobileApps } from "../lib/prefs";
import type { Service, ServiceSection } from "../lib/services";
import AppTile from "./AppTile.astro";

interface Props {
	sections: ServiceSection[];
	/** Starred apps; with any, the full list folds under "All apps". */
	favorites?: Service[];
	view?: AppView;
	/** Phone-app store buttons on tiles (the person's setting). */
	mobileApps?: MobileApps;
	/** Lets admins jump straight to adding apps from the empty state. */
	isAdmin?: boolean;
}
const { sections, favorites = [], view = "auto", mobileApps = "auto", isAdmin = false } = Astro.props;
const total = sections.reduce((n, s) => n + s.services.length, 0);
---

{
	sections.length === 0 ? (
		<p class="empty card">
			{isAdmin ? (
				<>No apps yet. <a href="/admin/apps">Add the first one</a>.</>
			) : (
				"You're signed in, but no services are shared with your account yet. Ask a family admin to add you to a group."
			)}
		</p>
	) : (
		<div class="apps" data-view={view}>
			{favorites.length > 0 && (
				<div class="group group--fav">
					<h3 class="group__title">
						<span aria-hidden="true">★</span> Favorites
					</h3>
					<ul class="grid" role="list">
						{favorites.map((svc) => (
							<li>
								<AppTile svc={svc} mobileApps={mobileApps} />
							</li>
						))}
					</ul>
				</div>
			)}
			{/* Always a <details>; without favorites it's open and the summary is hidden. */}
			<details class="all" open={favorites.length === 0} data-foldable={favorites.length > 0 ? "" : undefined}>
				<summary class="all__toggle">
					All apps <span class="all__count">{total}</span>
				</summary>
				<div class="groups">
					{sections.map((section) => (
						<div class="group">
							{section.title && <h3 class="group__title">{section.title}</h3>}
							<ul class="grid" role="list">
								{section.services.map((svc) => (
									<li>
										<AppTile svc={svc} mobileApps={mobileApps} />
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</details>
		</div>
	)
}

<script is:inline>
	// "Automatic" phone-app buttons: reveal the ones for this phone's OS. iPads
	// report themselves as Macs, so a touch-screen "Mac" counts as iOS.
	(() => {
		const ua = navigator.userAgent;
		const os = /android/i.test(ua)
			? "android"
			: /iphone|ipad|ipod/i.test(ua) || (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1)
				? "ios"
				: null;
		if (!os) return;
		for (const a of document.querySelectorAll(`.apps .store[data-os="${os}"][hidden]`)) a.hidden = false;
	})();
</script>

<script>
	// "All apps" (shown when someone has favorites): open on phones, where the
	// Apps tab is the whole screen; elsewhere remember what the person chose.
	const KEY = "hub:all-apps-open";
	for (const all of document.querySelectorAll<HTMLDetailsElement>("details[data-foldable]")) {
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(KEY);
		} catch {}
		all.open = matchMedia("(max-width: 899px)").matches || saved === "1";
		all.addEventListener("toggle", () => {
			try {
				localStorage.setItem(KEY, all.open ? "1" : "0");
			} catch {}
		});
	}
</script>

<style>
	/* Sized by the space it gets (sidebar, phone panel, full desktop width), not the viewport. */
	.apps {
		container: apps / inline-size;
	}
	.group + .group,
	.group--fav + .all {
		margin-top: 18px;
	}
	.group__title {
		margin: 0 0 10px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.group--fav .group__title span {
		color: var(--accent);
	}
	/* Icon grid, phone-home-screen style (compact, and auto when narrow). */
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
		gap: 14px 8px;
	}
	.all:not([data-foldable]) > .all__toggle {
		display: none;
	}
	.all__toggle {
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 36px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}
	.all__toggle::-webkit-details-marker {
		display: none;
	}
	.all__toggle::after {
		content: "▾";
		font-size: 0.8em;
		color: var(--muted);
	}
	.all[open] > .all__toggle::after {
		content: "▴";
	}
	.all__toggle:hover {
		border-color: var(--accent);
	}
	.all__count {
		color: var(--muted);
		font-weight: 500;
	}
	.all[data-foldable][open] > .groups {
		margin-top: 16px;
	}

	/* Detailed: rows with descriptions, as many columns as fit. */
	.apps[data-view="detailed"] .grid {
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 10px;
	}
	@container apps (min-width: 520px) and (max-width: 899px) {
		.apps[data-view="auto"] .grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
		}
	}

	/*
	 * Full desktop width (the strip above the feed): icon sections sit side by
	 * side and wrap, so a few apps take one short row and many stay compact.
	 */
	@container apps (min-width: 900px) {
		.apps:not([data-view="detailed"]) .groups {
			display: flex;
			flex-wrap: wrap;
			gap: 20px 44px;
		}
		.apps:not([data-view="detailed"]) .group + .group {
			margin-top: 0;
		}
		.apps:not([data-view="detailed"]) .grid {
			display: flex;
			flex-wrap: wrap;
			gap: 12px 6px;
		}
		.apps:not([data-view="detailed"]) .grid > li {
			width: 84px;
		}
	}

	.empty {
		padding: 16px;
		margin: 0;
		color: var(--muted);
	}
</style>
