---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---

<Base title="Not found" path={["not-found"]}>
	<section class="missing">
		<h1>Page not found</h1>
		<p class="bw-soft">It may have been moved or unpublished.</p>
		<a href="/" class="bw-btn bw-btn--primary">Back home</a>
	</section>
</Base>

<style>
	.missing {
		display: grid;
		gap: var(--space-3);
		justify-items: start;
	}
</style>
