---
/**
 * The quick launcher dialog, on every page for signed-in people. It uses the
 * style guide's bw-launcher markup, the same dialog every other app's header
 * opens (those fetch /api/apps; the hub renders its list here directly). Any
 * [data-launcher-open] button opens it (the header has two), as do "/" and
 * ⌘K / Ctrl+K; type to filter, ↑↓ and Enter to open.
 */
import type { Launcher } from "../lib/services";
import AppIcon from "./AppIcon.astro";
import Icon from "./brand/Icon.astro";

interface Props {
	launcher: Launcher;
}
const { launcher } = Astro.props;
const groups = [
	...(launcher.favorites.length ? [{ id: "fav", title: "Favorites", services: launcher.favorites, fav: true }] : []),
	...launcher.sections.map((s) => ({ ...s, fav: false })),
];
---

{
	groups.length > 0 && (
		<>
			<dialog id="launcher" class="bw-launcher" aria-label="Apps">
				<div class="bw-launcher__head">
					<input
						type="search"
						class="bw-launcher__input"
						placeholder="Find an app…"
						aria-label="Find an app"
						aria-controls="launcher-list"
						autocomplete="off"
						spellcheck="false"
					/>
					<form method="dialog">
						<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon" aria-label="Close">
							<Icon name="close" />
						</button>
					</form>
				</div>
				<div class="bw-launcher__list" id="launcher-list">
					{groups.map((g) => (
						<section class="bw-launcher__group" data-fav={g.fav ? "" : undefined}>
							<h3 class="bw-launcher__title">{g.title}</h3>
							<ul role="list">
								{g.services.map((svc) => (
									<li>
										<a
											class="bw-launcher__row"
											href={svc.url}
											rel="noopener"
											data-search={`${svc.name} ${svc.description ?? ""} ${g.fav ? "" : g.title}`.toLowerCase()}
										>
											<AppIcon name={svc.name} icon={svc.icon} size={28} lazy />
											<span class="bw-launcher__name">{svc.name}</span>
											{svc.description && <span class="bw-launcher__desc">{svc.description}</span>}
										</a>
									</li>
								))}
							</ul>
						</section>
					))}
					<p class="bw-launcher__none" hidden>No apps match.</p>
				</div>
				<p class="bw-launcher__foot">
					<kbd>↑</kbd><kbd>↓</kbd> move · <kbd>Enter</kbd> open · <kbd>/</kbd> or <kbd>⌘K</kbd> from any page
				</p>
			</dialog>
		</>
	)
}

<script>
	const dialog = document.querySelector<HTMLDialogElement>("#launcher");
	if (dialog) {
		const input = dialog.querySelector<HTMLInputElement>(".bw-launcher__input")!;
		const rows = [...dialog.querySelectorAll<HTMLAnchorElement>(".bw-launcher__row")];
		const groups = [...dialog.querySelectorAll<HTMLElement>(".bw-launcher__group")];
		const none = dialog.querySelector<HTMLElement>(".bw-launcher__none")!;
		let active: HTMLAnchorElement | undefined;

		const visible = () => rows.filter((r) => !r.closest("[hidden]"));
		const setActive = (row?: HTMLAnchorElement) => {
			active?.classList.remove("is-active");
			active = row;
			row?.classList.add("is-active");
			row?.scrollIntoView({ block: "nearest" });
		};
		const filter = () => {
			const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			for (const row of rows) {
				row.parentElement!.hidden = !words.every((w) => row.dataset.search!.includes(w));
			}
			for (const group of groups) {
				// While searching, favorites would just repeat apps listed in their sections.
				group.hidden =
					(words.length > 0 && group.hasAttribute("data-fav")) || !group.querySelector("li:not([hidden])");
			}
			none.hidden = visible().length > 0;
			setActive(words.length ? visible()[0] : undefined);
		};
		const open = () => {
			if (dialog.open) return;
			input.value = "";
			filter();
			dialog.showModal();
			input.focus();
		};

		for (const button of document.querySelectorAll("[data-launcher-open]")) button.addEventListener("click", open);
		input.addEventListener("input", filter);
		input.addEventListener("keydown", (event) => {
			const list = visible();
			const i = active ? list.indexOf(active) : -1;
			if (event.key === "ArrowDown" || event.key === "ArrowUp") {
				event.preventDefault();
				const step = event.key === "ArrowDown" ? 1 : -1;
				setActive(list[(i + step + list.length) % list.length]);
			} else if (event.key === "Enter" && (active ?? list[0])) {
				event.preventDefault();
				const href = (active ?? list[0]).href;
				if (event.metaKey || event.ctrlKey) window.open(href, "_blank", "noopener");
				else location.href = href;
			}
		});
		// Click outside the panel (on the backdrop) closes it.
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});

		document.addEventListener("keydown", (event) => {
			const el = event.target as HTMLElement;
			const typing = el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName);
			const cmdK = event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey) && !event.altKey;
			const slash = event.key === "/" && !typing && !event.metaKey && !event.ctrlKey && !event.altKey;
			if (cmdK || slash) {
				event.preventDefault();
				dialog.open ? dialog.close() : open();
			}
		});
	}
</script>
