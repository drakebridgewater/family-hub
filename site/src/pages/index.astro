---
import { getEmDashCollection, getSiteSettings, getWidgetArea } from "emdash";
import { WidgetArea } from "emdash/ui";
import { termsForPosts } from "../lib/terms";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import Schedule from "../components/Schedule.astro";
import { getFamilyUser } from "../lib/auth";
import { arrange, isAppAdmin, servicesFor } from "../lib/services";
import { getSchedule, scheduleEnabled } from "../lib/calendar";
import { DEFAULT_PREFS, getPrefs, TABS, type HomeTab } from "../lib/prefs";
import { isMembersOnly } from "../lib/visibility";
import { canPost, NEW_POST_URL } from "../lib/editor-roles";

const PAGE_SIZE = 10;
const user = await getFamilyUser(Astro.request);

// "members" (default) keeps the family's whereabouts off the public internet.
const schedulePublic = (process.env.SCHEDULE_VISIBILITY ?? "members") === "public";
const showSchedule = scheduleEnabled() && (schedulePublic || !!user);

const [{ entries: recent }, sections, schedule, prefs, settings] = await Promise.all([
	// Over-fetch for visitors so hiding family-only posts still fills a page.
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: user ? PAGE_SIZE : PAGE_SIZE * 3 }),
	user ? servicesFor(user) : Promise.resolve([]),
	showSchedule ? getSchedule() : Promise.resolve([]),
	user ? getPrefs(user.username) : Promise.resolve(DEFAULT_PREFS),
	getSiteSettings(),
]);
const tagline = settings?.tagline || "";
const posts = (user ? recent : recent.filter((post) => !isMembersOnly(post))).slice(0, PAGE_SIZE);
const [postTerms, sidebarArea] = await Promise.all([termsForPosts(posts.map((p) => p.data.id)), getWidgetArea("sidebar")]);
const hasWidgets = (sidebarArea?.widgets.length ?? 0) > 0;
// Two columns on desktop when there's something for the sidebar.
const split = (!!user && showSchedule) || hasWidgets;
const launcher = arrange(sections, prefs);
const isAdmin = isAppAdmin(user);
const showNewPost = !!user && canPost(user.groups);
const scheduleLabel = prefs.days === 1 ? "Today" : `Next ${prefs.days} days`;
// Numbered sections, as the brand's home layout has them: apps, feed, then the schedule.
const num = (n: number) => String(n).padStart(2, "0");
const feedNum = num(user ? 2 : 1);

// The page differs per visitor, so never let a shared cache store it.
Astro.response.headers.set("Cache-Control", user ? "private, no-store" : "public, max-age=0, must-revalidate");
Astro.response.headers.set("Vary", "Cookie");

const firstName = user?.name.split(" ")[0];
const hour = Number(
	new Intl.DateTimeFormat("en-US", {
		hour: "numeric",
		hourCycle: "h23",
		timeZone: process.env.SITE_TIMEZONE || process.env.TZ || "America/Chicago",
	}).format(new Date()),
);
const greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";

// Phones show one panel at a time (?tab= from the tab bar, else the user's
// start tab); desktop shows the feed with schedule and apps beside it.
const tabs = user
	? [
			{ id: "feed", label: "Feed", icon: "family" as const },
			...(showSchedule ? [{ id: "schedule", label: "Schedule", icon: "trail" as const }] : []),
			{ id: "apps", label: "Apps", icon: "grid" as const },
		]
	: [];
const requested = Astro.url.searchParams.get("tab") as HomeTab | null;
const tabIds = tabs.map((t) => t.id);
const activeTab = [requested, prefs.startTab].find((t) => t && TABS.includes(t) && tabIds.includes(t)) ?? tabIds[0];
---

<Base user={user} tabs={tabs} activeTab={activeTab} launcher={user ? launcher : undefined} skyline>
	{
		user ? (
			<div class="bw-hero hello">
				<h1 class="bw-display">
					{greeting}, {firstName}
				</h1>
				{tagline && <p>{tagline}</p>}
			</div>
		) : (
			<div class="bw-hero">
				<h1 class="bw-display">Welcome, friends and family</h1>
				<p>
					Catch up on what we've been up to below. Family members can sign in to see the schedule and the
					shared apps.
				</p>
				<div class="hero__actions">
					<a href="/login" class="bw-btn bw-btn--primary">Sign in</a>
				</div>
			</div>
		)
	}

	{/* Apps span the full width on desktop, above the feed and schedule; a tab on phones. */}
	{
		user && (
			<section id="apps" class="bw-section panel panel--apps" aria-labelledby="apps-title">
				<div class="bw-section__head">
					<h2 id="apps-title"><span class="bw-secnum">01</span>Your apps</h2>
					<span class="apps-tools">
						<button type="button" class="bw-btn bw-btn--secondary bw-btn--sm findapp" data-launcher-open title="Find an app (press /)">
							Find an app <kbd>/</kbd>
						</button>
						<span class="viewswitch" role="group" aria-label="App layout">
							<button type="button" class="bw-btn bw-btn--sm" data-app-view="compact" aria-pressed={String(prefs.appView === "compact")} title="Compact: icons only">Icons</button>
							<button type="button" class="bw-btn bw-btn--sm" data-app-view="detailed" aria-pressed={String(prefs.appView === "detailed")} title="Detailed: show descriptions">Details</button>
						</span>
						<a class="section-link" href="/settings#apps">
							{launcher.hiddenCount ? `${launcher.hiddenCount} hidden · Edit` : "Edit"}
						</a>
						{isAdmin && (
							<a class="section-link" href="/admin/apps">Manage</a>
						)}
					</span>
				</div>
				<ServiceGrid sections={launcher.sections} favorites={launcher.favorites} view={prefs.appView} isAdmin={isAdmin} />
			</section>
		)
	}

	<div class:list={["home", { "bw-split": split }]}>
		<section id="feed" class="bw-section panel panel--feed" aria-labelledby="feed-title">
			<div class="bw-section__head">
				<h2 id="feed-title"><span class="bw-secnum">{feedNum}</span>Family feed</h2>
				{showNewPost && (
					<a href={NEW_POST_URL} class="bw-btn bw-btn--primary bw-btn--sm">New post</a>
				)}
			</div>
			{
				posts.length === 0 ? (
					<p class="empty">
						{showNewPost ? (
							<>No posts yet. <a href={NEW_POST_URL}>Write the first one</a>.</>
						) : (
							"No posts yet. Check back soon."
						)}
					</p>
				) : (
					<div class="feed">
						{posts.map((post, i) => (
							<PostCard post={post} priority={i === 0} terms={postTerms.get(post.data.id)} />
						))}
					</div>
				)
			}
		</section>

		{split && (
		<aside class="side" aria-label="Schedule and more">
			{
				user && showSchedule && (
					<section id="schedule" class="bw-section panel panel--schedule" aria-labelledby="schedule-title">
						<div class="bw-section__head">
							<h2 id="schedule-title"><span class="bw-secnum">03</span>Coming up</h2>
							<a class="section-link" href="/settings#days">
								{scheduleLabel}
							</a>
						</div>
						<Schedule items={schedule} days={prefs.days} />
					</section>
				)
			}
			{/* EmDash widgets: create a widget area named "sidebar" in the admin. On phones they show under the feed. */}
			{hasWidgets && (
				<section class="bw-section panel panel--feed widgets">
					<WidgetArea name="sidebar" />
				</section>
			)}
		</aside>
		)}
	</div>
</Base>

<script>
	// Compact/detailed apps switch: apply instantly, then remember it for this user.
	// Pressing the active button again goes back to "auto" (icons when narrow, details when wide).
	const apps = document.querySelector<HTMLElement>("#apps .apps");
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-app-view]");
	for (const button of buttons) {
		button.addEventListener("click", () => {
			const view = button.getAttribute("aria-pressed") === "true" ? "auto" : button.dataset.appView!;
			if (apps) apps.dataset.view = view;
			for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.appView === view));
			fetch("/api/prefs", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ appView: view }),
			}).catch(() => {});
		});
	}
</script>

<style>
	.hero__actions {
		margin-top: var(--space-5);
	}
	/* The apps section comes before the feed and schedule, so space them as sections. */
	.panel--apps + .home {
		margin-top: var(--space-7);
	}
	.apps-tools {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
	}
	.findapp kbd {
		margin-left: var(--space-1);
	}
	.viewswitch {
		display: inline-flex;
	}
	.viewswitch .bw-btn {
		border-color: var(--line-strong);
		border-radius: 0;
	}
	.viewswitch .bw-btn:first-child {
		border-radius: var(--radius-sm) 0 0 var(--radius-sm);
	}
	.viewswitch .bw-btn + .bw-btn {
		margin-left: calc(-1 * var(--field-border));
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
	}
	/* Selected is the signature: green, which is also the "selected" role. */
	.viewswitch .bw-btn[aria-pressed="true"] {
		background: var(--sig-tint);
		border-color: var(--sig);
		color: var(--ink);
		position: relative;
	}
	/* Phones: one panel at a time, picked by the tab bar (body[data-tab]). */
	@media (max-width: 899px) {
		:global(body[data-tab="feed"]) .panel:not(.panel--feed),
		:global(body[data-tab="schedule"]) .panel:not(.panel--schedule),
		:global(body[data-tab="apps"]) .panel:not(.panel--apps) {
			display: none;
		}
		.hello {
			display: none;
		}
		:global(body[data-tab="feed"]) .hello {
			display: block;
		}
		.panel--apps + .home {
			margin-top: 0;
		}
		.bw-split {
			gap: 0;
		}
		.side .bw-section {
			margin-top: var(--space-6);
		}
		:global(body[data-tab="schedule"]) .side .panel--schedule {
			margin-top: 0;
		}
		/* No "/" key on a phone; the button still opens the search. */
		.findapp kbd,
		.viewswitch {
			display: none;
		}
		.bw-section__head h2 {
			white-space: nowrap;
		}
	}
	/* Phones: the header's apps button does the same, and the row is tight. */
	@media (max-width: 559px) {
		.findapp {
			display: none;
		}
	}
	@media (min-width: 900px) {
		.side {
			position: sticky;
			top: var(--space-5);
			max-height: calc(100vh - var(--space-6));
			overflow-y: auto;
			overscroll-behavior: contain;
			scrollbar-width: thin;
		}
	}
	/* EmDash widgets: grouped by hairlines and space, like everything else. */
	.widgets :global(.widget-area) {
		display: grid;
		gap: var(--space-5);
	}
	.widgets :global(.widget) {
		border-top: var(--hairline) solid var(--line);
		padding-top: var(--space-3);
	}
	.widgets :global(.widget__title) {
		margin: 0 0 var(--space-2);
		font: var(--type-h3);
	}
	.widgets :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}
	.widgets :global(li) {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		color: var(--comment);
		font: var(--type-mono-small);
	}
	.widgets :global(a) {
		font: var(--type-body);
		text-decoration: none;
		padding: var(--space-1) 0;
	}
	.widgets :global(a:hover) {
		text-decoration: underline;
	}
	.feed {
		border-top: var(--hairline) solid var(--line);
	}
</style>
