---
/** The mark and logotype drawn inside the Wordmark's SVG, in the Logo's units. */
import shapes from "../../styles/bridgewater/shapes.json";

const { lt, mark: m } = shapes;
const ox = 39;
const oy = 6;
---

<g transform="scale(0.5)">
	<path class="bw-mark-ridge" d={m.ridge} />
	<path class="bw-mark-trace" d={m.trace} />
	{m.pads.map(([cx, cy, r]) => <circle class="bw-mark-pad" cx={cx} cy={cy} r={r} />)}
	<circle class="bw-mark-dot" cx={m.dot[0]} cy={m.dot[1]} r={m.dot[2]} />
</g>
<g class="bw-lt-glyph" transform={`translate(${ox} ${oy})`}>
	{lt.paths.map(([x, d]) => <path transform={`translate(${x} 0)`} d={d as string} />)}
</g>
<path class="bw-lt-trace" d={lt.hbus} />
{lt.idots.map((x) => <circle class="bw-lt-idot" cx={x + ox} cy={1.9 + oy} r="1.35" />)}
<circle class="bw-lt-pad" cx={lt.dotx + ox} cy={13.1 + oy} r="2.8" />
<circle class="bw-lt-dot" cx={lt.dotx + ox} cy={13.1 + oy} r="1.7" />
