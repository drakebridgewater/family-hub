---
import { getSiteSettings } from "emdash";
import type { FamilyUser } from "../lib/auth";
import { logoutUrl } from "../lib/auth";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	user?: FamilyUser | null;
	/**
	 * Bottom tab bar (home page only). On phones each tab shows one panel of
	 * the page; on desktop everything is visible and the bar is hidden.
	 */
	tabs?: Array<{ id: string; label: string; icon: string }>;
	/** Tab shown first on phones. */
	activeTab?: string;
	/** Wider frame for the two-column desktop home page. */
	wide?: boolean;
}

const { title, description, user = null, tabs = [], activeTab, wide = false } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "The Bridgewaters";
const tagline = settings?.tagline || "";
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;

const initials = (user?.name ?? "")
	.split(/\s+/)
	.map((p) => p[0])
	.join("")
	.slice(0, 2)
	.toUpperCase();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f6f3ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="description" content={description ?? tagline} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<title>{pageTitle}</title>
	</head>
	<body class:list={{ "has-tabs": tabs.length > 0, wide }} data-tab={tabs.length ? activeTab ?? tabs[0].id : undefined}>
		<header class="topbar">
			<div class="frame topbar__inner">
				<a href="/" class="brand">
					<span class="brand__mark" aria-hidden="true">❦</span>
					<span class="brand__name">{siteTitle}</span>
				</a>
				{
					user ? (
						<details class="account">
							<summary class="avatar" aria-label={`Account menu for ${user.name}`}>
								{initials || "🙂"}
							</summary>
							<div class="account__menu card">
								<p class="account__who">
									<strong>{user.name}</strong>
									<span>{user.email || user.username}</span>
								</p>
								<a href="/settings" class="btn btn--ghost">Customize home</a>
								<a href={logoutUrl()} class="btn btn--ghost">Sign out</a>
							</div>
						</details>
					) : (
						<a href="/login" class="btn signin">Family sign in</a>
					)
				}
			</div>
		</header>

		<main class="frame main">
			<slot />
		</main>

		<footer class="frame footer">
			<p>{tagline}</p>
		</footer>

		{
			tabs.length > 0 && (
				<nav class="tabbar" aria-label="Sections">
					{tabs.map((t) => (
						<a
							href={`/?tab=${t.id}`}
							class="tabbar__item"
							data-tab-link={t.id}
							aria-current={(activeTab ?? tabs[0].id) === t.id ? "page" : undefined}
						>
							<span class="tabbar__icon" aria-hidden="true">{t.icon}</span>
							<span>{t.label}</span>
						</a>
					))}
				</nav>
			)
		}
		{
			tabs.length > 0 && (
				<script>
					// Switch panels in place instead of reloading (the links still work without JS).
					for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-tab-link]")) {
						link.addEventListener("click", (event) => {
							const tab = link.dataset.tabLink!;
							event.preventDefault();
							document.body.dataset.tab = tab;
							for (const other of document.querySelectorAll("[data-tab-link]")) {
								other.toggleAttribute("aria-current", other === link);
								if (other === link) other.setAttribute("aria-current", "page");
							}
							history.replaceState(null, "", `/?tab=${tab}`);
							window.scrollTo({ top: 0 });
						});
					}
				</script>
			)
		}
	</body>
</html>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--line);
		padding-top: env(safe-area-inset-top);
	}
	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 60px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		min-width: 0;
	}
	.brand__mark {
		color: var(--accent);
		font-size: 1.4rem;
	}
	.brand__name {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.15rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.signin {
		min-height: 38px;
		padding: 0 14px;
		font-size: 0.9rem;
		flex-shrink: 0;
	}
	.account {
		position: relative;
	}
	.avatar {
		list-style: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 700;
		font-size: 0.9rem;
		cursor: pointer;
	}
	.avatar::-webkit-details-marker {
		display: none;
	}
	.account__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		width: min(260px, calc(100vw - 32px));
		padding: 16px;
		display: grid;
		gap: 12px;
	}
	.account__who {
		margin: 0;
		display: grid;
		font-size: 0.9rem;
	}
	.account__who span {
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.wide {
		--max: 1120px;
	}
	.main {
		padding-top: 8px;
		padding-bottom: 32px;
	}
	.footer {
		color: var(--muted);
		font-size: 0.85rem;
		text-align: center;
		padding-bottom: 32px;
	}
	.has-tabs .footer {
		padding-bottom: calc(var(--nav-h) + 32px + env(safe-area-inset-bottom));
	}
	.tabbar {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 20;
		display: flex;
		justify-content: space-around;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-top: 1px solid var(--line);
		padding-bottom: env(safe-area-inset-bottom);
	}
	.tabbar__item {
		flex: 1;
		min-height: var(--nav-h);
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 2px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--muted);
		text-decoration: none;
	}
	.tabbar__item[aria-current="page"] {
		color: var(--accent);
	}
	.tabbar__icon {
		font-size: 1.3rem;
		line-height: 1;
	}
	/* On wider screens the tab bar is unnecessary: everything fits. */
	@media (min-width: 900px) {
		.tabbar {
			display: none;
		}
		.has-tabs .footer {
			padding-bottom: 32px;
		}
	}
</style>
