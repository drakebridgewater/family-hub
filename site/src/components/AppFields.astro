---
/** Inputs for one app on /admin/apps (add and edit forms). */
import type { Service, ServiceSection } from "../lib/services";
import { resolveIcon } from "../lib/services";

interface Props {
	svc?: Service;
	/** Every section; editing an app can move it to another one. */
	sections?: ServiceSection[];
	sectionId: string;
	/** Groups to offer as checkboxes. */
	knownGroups: string[];
}
const { svc, sections = [], sectionId, knownGroups } = Astro.props;
const uid = svc?.id ?? `new-${sectionId}`;
const groups = new Set(svc?.groups ?? []);
const otherGroups = [...groups].filter((g) => !knownGroups.includes(g)).join(", ");
const preview = svc?.icon ? resolveIcon(svc.icon) : null;
const policies = [
	{ id: "optional", label: "Shown", hint: "People can hide it for themselves" },
	{ id: "always", label: "Always shown", hint: "Can't be hidden" },
	{ id: "hidden", label: "Hidden", hint: "Off for everyone, kept for later" },
];
---

<div class="fields" data-app-fields data-new={svc ? undefined : ""}>
	<label class="field">
		<span class="field__label">Name</span>
		<input class="bw-field__control" name="name" required maxlength="60" value={svc?.name} placeholder="Jellyfin" autocomplete="off" />
	</label>
	<label class="field">
		<span class="field__label">Web address</span>
		<input
			class="bw-field__control bw-field__control--mono"
			name="url"
			required
			maxlength="500"
			value={svc?.url}
			placeholder="https://jellyfin.example.com"
			pattern="(https?://.+|/[^/].*)"
			title="https://… or a path on this site like /photos"
			autocomplete="off"
		/>
	</label>
	<div class="field field--icon">
		<label for={`icon-${uid}`} class="field__label">Icon</label>
		<div class="icon-row">
			<span class:list={["bw-tile icon-preview", { "bw-tile--icon": preview && preview.kind !== "letter" }]} aria-hidden="true" data-icon-preview>
				{preview?.kind === "img" ? <img src={preview.value} alt="" width="28" height="28" /> : preview?.kind === "glyph" ? preview.value : (svc?.name.trim().charAt(0).toUpperCase() || "?")}
			</span>
			<input id={`icon-${uid}`} class="bw-field__control bw-field__control--mono" name="icon" maxlength="300" value={svc?.icon} placeholder="jellyfin" autocomplete="off" />
		</div>
		<span class="field__hint">
			A <a href="https://dashboardicons.com" target="_blank" rel="noopener">dashboard-icons</a> name, an image URL, or an
			emoji.
		</span>
	</div>
	<label class="field">
		<span class="field__label">Description <span class="field__opt">optional</span></span>
		<input class="bw-field__control" name="description" maxlength="120" value={svc?.description} placeholder="Movies & TV" autocomplete="off" />
	</label>
	<fieldset class="field">
		<legend class="field__label">Who sees it</legend>
		<div class="checks">
			{
				knownGroups.map((g) => (
					<label class="check">
						<input type="checkbox" name="groups" value={g} checked={groups.has(g)} />
						<span class="bw-mono">{g}</span>
					</label>
				))
			}
		</div>
		<input class="bw-field__control bw-field__control--mono" name="otherGroups" value={otherGroups} placeholder="Other groups, comma-separated" autocomplete="off" />
		<span class="field__hint">None ticked = everyone who's signed in.</span>
	</fieldset>
	<fieldset class="field">
		<legend class="field__label">Visibility</legend>
		<div class="checks">
			{
				policies.map((p) => (
					<label class="check" title={p.hint}>
						<input type="radio" name="policy" value={p.id} checked={(svc?.policy ?? "optional") === p.id} />
						<span>{p.label}</span>
					</label>
				))
			}
		</div>
		<span class="field__hint">{policies.map((p) => `${p.label}: ${p.hint.toLowerCase()}.`).join(" ")}</span>
	</fieldset>
	{
		svc && sections.length > 1 && (
			<label class="field">
				<span class="field__label">Section</span>
				<select class="bw-field__control" name="moveTo">
					{sections.map((s) => (
						<option value={s.id} selected={s.id === sectionId}>
							{s.title || "(untitled)"}
						</option>
					))}
				</select>
			</label>
		)
	}
</div>

<script>
	// Live icon preview, and for new apps, guess the dashboard-icons name from
	// the app's name (kept only if that icon actually exists).
	const CDN = "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/";
	const src = (icon: string) =>
		/^https?:\/\//.test(icon) || icon.startsWith("/") ? icon : /^[a-z0-9-]+$/.test(icon) ? `${CDN}${icon}.png` : null;

	for (const fields of document.querySelectorAll<HTMLElement>("[data-app-fields]")) {
		const name = fields.querySelector<HTMLInputElement>("[name=name]")!;
		const icon = fields.querySelector<HTMLInputElement>("[name=icon]")!;
		const preview = fields.querySelector<HTMLElement>("[data-icon-preview]")!;
		let guessed = false;

		// No icon: a letter tile from the name, like the launcher draws it.
		const letter = () => name.value.trim().charAt(0).toUpperCase() || "?";
		const show = () => {
			const value = icon.value.trim();
			const url = value ? src(value) : null;
			preview.replaceChildren();
			preview.classList.toggle("bw-tile--icon", !!value);
			if (!url) {
				preview.textContent = value || letter();
				return;
			}
			const img = new Image(28, 28);
			img.alt = "";
			img.onerror = () => {
				if (guessed) {
					icon.value = "";
					guessed = false;
				}
				preview.classList.toggle("bw-tile--icon", !!icon.value);
				preview.textContent = icon.value ? "?" : letter();
			};
			img.src = url;
			preview.append(img);
		};
		icon.addEventListener("input", () => {
			guessed = false;
			show();
		});
		name.addEventListener("input", () => {
			if (!icon.value.trim()) show();
		});
		if (fields.hasAttribute("data-new")) {
			name.addEventListener("change", () => {
				if (icon.value && !guessed) return;
				const slug = name.value.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
				icon.value = slug;
				guessed = !!slug;
				show();
			});
		}
	}
</script>

<style>
	.fields {
		display: grid;
		gap: var(--space-4);
	}
	.field {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.field__label {
		padding: 0;
		font: var(--type-label);
	}
	.field__opt,
	.field__hint {
		color: var(--comment);
		font: var(--type-small);
	}
	.icon-row {
		display: flex;
		gap: var(--space-3);
		align-items: center;
	}
	/* An emoji fills the tile; letters keep the tile's own size. */
	.icon-preview.bw-tile--icon {
		font-size: calc(var(--tile) * 0.65);
	}
	.icon-preview :global(img) {
		width: 28px;
		height: 28px;
		object-fit: contain;
	}
	.checks {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin-bottom: var(--space-2);
	}
	.check {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--control-sm);
		font: var(--type-small);
		cursor: pointer;
	}
	.check input {
		width: 18px;
		height: 18px;
		accent-color: var(--sig-fill);
		margin: 0;
	}
</style>
