---
/** A titled list of post cards, for category, tag and archive pages. */
import type { ContentEntry } from "emdash";
import PostCard from "./PostCard.astro";
import { termsForPosts } from "../lib/terms";

interface Props {
	posts: ContentEntry<any>[];
	heading: string;
	eyebrow: string;
}
const { posts, heading, eyebrow } = Astro.props;
const terms = await termsForPosts(posts.map((p) => p.data.id));
---

<div class="bw-pagehead">
	<div class="bw-pagehead__text">
		<h1>{heading}</h1>
		<p class="bw-pagehead__meta">{eyebrow} · <span class="bw-mono">{posts.length} {posts.length === 1 ? "post" : "posts"}</span></p>
	</div>
</div>
{
	posts.length === 0 ? (
		<p class="empty">No posts here yet.</p>
	) : (
		<div class="list reading">
			{posts.map((post, i) => (
				<PostCard post={post} priority={i === 0} terms={terms.get(post.data.id)} />
			))}
		</div>
	)
}

<style>
	.list {
		border-top: var(--hairline) solid var(--line);
	}
</style>
