---
import type { ScheduleItem } from "../lib/calendar";
import { groupByDay } from "../lib/calendar";

interface Props {
	items: ScheduleItem[];
	/** Calendar days to show, starting today. */
	days?: number;
}
const { items, days = 7 } = Astro.props;
const grouped = groupByDay(items, days);
---

{
	grouped.length === 0 ? (
		<p class="empty">Nothing on the calendar {days === 1 ? "today" : `in the next ${days} days`}.</p>
	) : (
		<ol class="days" role="list">
			{grouped.map((day) => (
				<li class="day">
					<h3 class="label day__label">{day.label}</h3>
					<ul class="events" role="list">
						{day.items.map((ev) => (
							<li class="event">
								<span class="event__time bw-mono">{ev.time}</span>
								<span class="event__body">
									<span class="event__title">{ev.title}</span>
									<span class="event__meta">
										<span class="event__cal">{ev.calendar.toLowerCase()}</span>
										{ev.location && ` · ${ev.location}`}
									</span>
								</span>
							</li>
						))}
					</ul>
				</li>
			))}
		</ol>
	)
}

<style>
	.days {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--hairline) solid var(--line);
	}
	.day {
		padding: var(--space-3) 0 var(--space-4);
		border-bottom: var(--hairline) solid var(--line);
	}
	.day__label {
		margin-bottom: var(--space-2);
	}
	.events {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}
	.event {
		display: grid;
		grid-template-columns: 68px 1fr;
		gap: var(--space-3);
		align-items: baseline;
	}
	.event__time {
		font: var(--type-mono-small);
		color: var(--comment);
	}
	.event__body {
		display: grid;
		min-width: 0;
	}
	.event__title {
		font: var(--type-body-strong);
		overflow-wrap: anywhere;
	}
	.event__meta {
		font: var(--type-small);
		color: var(--comment);
		overflow-wrap: anywhere;
	}
	/* Which calendar, as a machine fact: its name in mono. Color stays for roles. */
	.event__cal {
		font: var(--type-mono-small);
	}
</style>
