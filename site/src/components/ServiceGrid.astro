---
import type { ServiceSection } from "../lib/services";
import { resolveIcon } from "../lib/services";

interface Props {
	sections: ServiceSection[];
}
const { sections } = Astro.props;
---

{
	sections.length === 0 ? (
		<p class="empty card">
			You're signed in, but no services are shared with your account yet. Ask a family admin to add you to a group.
		</p>
	) : (
		<div class="apps">
		{sections.map((section) => (
			<div class="group">
				{section.title && <h3 class="group__title">{section.title}</h3>}
				<ul class="grid" role="list">
					{section.services.map((svc) => {
						const icon = resolveIcon(svc.icon);
						return (
							<li>
								<a class="tile" href={svc.url} rel="noopener">
									<span class="tile__icon" aria-hidden="true">
										{icon.kind === "img" ? (
											<img src={icon.value} alt="" width="40" height="40" decoding="async" />
										) : (
											icon.value
										)}
									</span>
									<span class="tile__name">{svc.name}</span>
									{svc.description && <span class="tile__desc">{svc.description}</span>}
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		))}
		</div>
	)
}

<style>
	/* Sized by the space it gets (full column vs. desktop sidebar), not the viewport. */
	.apps {
		container-type: inline-size;
	}
	.group + .group {
		margin-top: 18px;
	}
	.group__title {
		margin: 0 0 10px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	/* Phone-home-screen style: 4 across on phones, roomier on larger screens. */
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px 8px;
	}
	.tile {
		display: grid;
		justify-items: center;
		gap: 6px;
		text-align: center;
		text-decoration: none;
		padding: 4px 0;
		border-radius: var(--radius-sm);
		-webkit-tap-highlight-color: transparent;
	}
	.tile__icon {
		width: 60px;
		height: 60px;
		border-radius: 16px;
		display: grid;
		place-items: center;
		font-size: 1.8rem;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		transition: transform 0.15s ease;
	}
	.tile:active .tile__icon {
		transform: scale(0.92);
	}
	.tile__icon img {
		width: 38px;
		height: 38px;
		object-fit: contain;
	}
	.tile__name {
		max-width: 100%;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tile__desc {
		display: none;
	}
	@container (min-width: 520px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
		}
		.tile {
			grid-template-columns: 52px 1fr;
			grid-template-rows: auto auto;
			justify-items: start;
			align-items: center;
			column-gap: 12px;
			row-gap: 0;
			text-align: left;
			padding: 10px 12px;
			background: var(--surface);
			border: 1px solid var(--line);
		}
		.tile:hover {
			border-color: var(--accent);
		}
		.tile__icon {
			grid-row: span 2;
			width: 52px;
			height: 52px;
			box-shadow: none;
			background: var(--surface-2);
			border: 0;
		}
		.tile__name {
			font-size: 0.95rem;
			align-self: end;
			white-space: normal;
		}
		.tile__desc {
			display: block;
			font-size: 0.8rem;
			color: var(--muted);
			align-self: start;
		}
	}
	.empty {
		padding: 16px;
		margin: 0;
		color: var(--muted);
	}
</style>
