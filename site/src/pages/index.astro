---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import Schedule from "../components/Schedule.astro";
import { getFamilyUser } from "../lib/auth";
import { servicesFor, withoutHidden } from "../lib/services";
import { getSchedule, scheduleEnabled } from "../lib/calendar";
import { DEFAULT_PREFS, getPrefs, TABS, type HomeTab } from "../lib/prefs";

const PAGE_SIZE = 10;
const user = await getFamilyUser(Astro.request);

// "members" (default) keeps the family's whereabouts off the public internet.
const schedulePublic = (process.env.SCHEDULE_VISIBILITY ?? "members") === "public";
const showSchedule = scheduleEnabled() && (schedulePublic || !!user);

const [{ entries: posts }, sections, schedule, prefs] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: PAGE_SIZE }),
	user ? servicesFor(user) : Promise.resolve([]),
	showSchedule ? getSchedule() : Promise.resolve([]),
	user ? getPrefs(user.username) : Promise.resolve(DEFAULT_PREFS),
]);
const visibleSections = withoutHidden(sections, prefs.hidden);
const hiddenCount = sections.reduce((n, s) => n + s.services.length, 0) - visibleSections.reduce((n, s) => n + s.services.length, 0);
const scheduleLabel = prefs.days === 1 ? "Today" : `Next ${prefs.days} days`;

// The page differs per visitor, so never let a shared cache store it.
Astro.response.headers.set("Cache-Control", user ? "private, no-store" : "public, max-age=0, must-revalidate");
Astro.response.headers.set("Vary", "Cookie");

const firstName = user?.name.split(" ")[0];
const hour = Number(
	new Intl.DateTimeFormat("en-US", {
		hour: "numeric",
		hourCycle: "h23",
		timeZone: process.env.SITE_TIMEZONE || process.env.TZ || "America/Chicago",
	}).format(new Date()),
);
const greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";

// Phones show one panel at a time (?tab= from the tab bar, else the user's
// start tab); desktop shows the feed with schedule and apps beside it.
const tabs = user
	? [
			{ id: "feed", label: "Feed", icon: "☰" },
			...(showSchedule ? [{ id: "schedule", label: "Schedule", icon: "◷" }] : []),
			{ id: "apps", label: "Apps", icon: "▦" },
		]
	: [];
const requested = Astro.url.searchParams.get("tab") as HomeTab | null;
const tabIds = tabs.map((t) => t.id);
const activeTab = [requested, prefs.startTab].find((t) => t && TABS.includes(t) && tabIds.includes(t)) ?? tabIds[0];
---

<Base user={user} tabs={tabs} activeTab={activeTab} wide={!!user}>
	{
		user ? (
			<section class="hello" aria-labelledby="hello-title">
				<h1 id="hello-title" class="hello__title">
					{greeting}, {firstName} 👋
				</h1>
			</section>
		) : (
			<section class="welcome card" aria-labelledby="welcome-title">
				<h1 id="welcome-title" class="welcome__title">Welcome, friends &amp; family</h1>
				<p class="welcome__sub">
					Catch up on what we've been up to below. Family members can sign in to see our schedule and the
					shared apps.
				</p>
				<a href="/login" class="btn">Sign in with your family account</a>
			</section>
		)
	}

	<div class:list={["home", { "home--split": !!user }]}>
		<section id="feed" class="section panel panel--feed" aria-labelledby="feed-title">
			<div class="section__head">
				<h2 id="feed-title" class="section__title">Family feed</h2>
			</div>
			{
				posts.length === 0 ? (
					<p class="card empty">No posts yet. Check back soon!</p>
				) : (
					<div class="feed">
						{posts.map((post, i) => (
							<PostCard post={post} priority={i === 0} />
						))}
					</div>
				)
			}
		</section>

		{
			user && (
				<aside class="side" aria-label="Schedule and apps">
					{showSchedule && (
						<section id="schedule" class="section panel panel--schedule" aria-labelledby="schedule-title">
							<div class="section__head">
								<h2 id="schedule-title" class="section__title">Coming up</h2>
								<a class="section__meta section__link" href="/settings#days">
									{scheduleLabel}
								</a>
							</div>
							<Schedule items={schedule} days={prefs.days} />
						</section>
					)}
					<section id="apps" class="section panel panel--apps" aria-labelledby="apps-title">
						<div class="section__head">
							<h2 id="apps-title" class="section__title">Your apps</h2>
							<a class="section__meta section__link" href="/settings#apps">
								{hiddenCount ? `${hiddenCount} hidden · Edit` : "Edit"}
							</a>
						</div>
						<ServiceGrid sections={visibleSections} />
					</section>
				</aside>
			)
		}
	</div>
</Base>

<style>
	.hello {
		padding-top: 12px;
	}
	.hello__title {
		font-family: var(--font-serif);
		font-size: clamp(1.6rem, 6vw, 2.1rem);
		line-height: 1.15;
		margin: 0;
	}
	.hello__sub {
		margin: 4px 0 0;
		color: var(--muted);
	}
	.welcome {
		margin-top: 12px;
		padding: 22px 20px;
		background: linear-gradient(160deg, var(--accent-soft), var(--surface) 70%);
	}
	.welcome__title {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 6vw, 2rem);
		line-height: 1.15;
		margin: 0;
	}
	.welcome__sub {
		margin: 8px 0 16px;
		color: var(--muted);
	}
	.welcome .btn {
		width: 100%;
	}
	@media (min-width: 560px) {
		.welcome .btn {
			width: auto;
		}
	}
	.section__link {
		text-decoration: none;
		white-space: nowrap;
	}
	.section__link:hover {
		color: var(--accent);
	}
	/* Phones: one panel at a time, picked by the tab bar (body[data-tab]). */
	@media (max-width: 899px) {
		:global(body[data-tab="feed"]) .panel:not(.panel--feed),
		:global(body[data-tab="schedule"]) .panel:not(.panel--schedule),
		:global(body[data-tab="apps"]) .panel:not(.panel--apps) {
			display: none;
		}
		.hello {
			display: none;
		}
		:global(body[data-tab="feed"]) .hello {
			display: block;
		}
		.home .section:first-child,
		.side .section {
			margin-top: 16px;
		}
	}
	/* Desktop: feed on the left, schedule and apps beside it. */
	@media (min-width: 900px) {
		.home--split {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 40px;
			align-items: start;
		}
		.side {
			position: sticky;
			top: 76px;
			max-height: calc(100vh - 92px);
			overflow-y: auto;
			overscroll-behavior: contain;
			scrollbar-width: thin;
		}
		.side .section:first-child {
			margin-top: 28px;
		}
	}
	.feed {
		display: grid;
		gap: 16px;
	}
	.empty {
		padding: 16px;
		margin: 0;
		color: var(--muted);
	}
</style>
