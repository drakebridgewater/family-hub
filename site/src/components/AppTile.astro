---
import type { Service } from "../lib/services";
import AppIcon from "./AppIcon.astro";

interface Props {
	svc: Service;
}
const { svc } = Astro.props;
---

<a class="app" href={svc.url} rel="noopener" title={svc.description}>
	<AppIcon name={svc.name} icon={svc.icon} />
	<span class="bw-apps__name app__name">{svc.name}</span>
	{svc.description && <span class="bw-apps__desc app__desc">{svc.description}</span>}
</a>

<style>
	/* A row of the brand's app grid (ul.bw-apps in ServiceGrid, which also draws the compact icon view). */
	.app {
		-webkit-tap-highlight-color: transparent;
	}
</style>
