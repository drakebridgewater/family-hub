---
import type { AppView } from "../lib/prefs";
import type { Service, ServiceSection } from "../lib/services";
import AppTile from "./AppTile.astro";

interface Props {
	sections: ServiceSection[];
	/** Starred apps; with any, the full list folds under "All apps". */
	favorites?: Service[];
	view?: AppView;
	/** Lets admins jump straight to adding apps from the empty state. */
	isAdmin?: boolean;
}
const { sections, favorites = [], view = "auto", isAdmin = false } = Astro.props;
const total = sections.reduce((n, s) => n + s.services.length, 0);
---

{
	sections.length === 0 ? (
		<p class="empty">
			{isAdmin ? (
				<>No apps yet. <a href="/admin/apps">Add the first one</a>.</>
			) : (
				"You're signed in, but no services are shared with your account yet. Ask a family admin to add you to a group."
			)}
		</p>
	) : (
		<div class="apps" data-view={view}>
			{favorites.length > 0 && (
				<div class="group group--fav">
					<h3 class="label group__title">Favorites</h3>
					<ul class="grid" role="list">
						{favorites.map((svc) => (
							<li>
								<AppTile svc={svc} />
							</li>
						))}
					</ul>
				</div>
			)}
			{/* Always a <details>; without favorites it's open and the summary is hidden. */}
			<details class="all" open={favorites.length === 0} data-foldable={favorites.length > 0 ? "" : undefined}>
				<summary class="bw-btn bw-btn--secondary bw-btn--sm all__toggle">
					All apps <span class="bw-count">{total}</span>
				</summary>
				<div class="groups">
					{sections.map((section) => (
						<div class="group">
							{section.title && <h3 class="label group__title">{section.title}</h3>}
							<ul class="grid" role="list">
								{section.services.map((svc) => (
									<li>
										<AppTile svc={svc} />
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</details>
		</div>
	)
}

<script>
	// "All apps" (shown when someone has favorites): open on phones, where the
	// Apps tab is the whole screen; elsewhere remember what the person chose.
	const KEY = "hub:all-apps-open";
	for (const all of document.querySelectorAll<HTMLDetailsElement>("details[data-foldable]")) {
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(KEY);
		} catch {}
		all.open = matchMedia("(max-width: 899px)").matches || saved === "1";
		all.addEventListener("toggle", () => {
			try {
				localStorage.setItem(KEY, all.open ? "1" : "0");
			} catch {}
		});
	}
</script>

<style>
	/* Sized by the space it gets (sidebar, phone panel, full desktop width), not the viewport. */
	.apps {
		container: apps / inline-size;
	}
	.group + .group,
	.group--fav + .all {
		margin-top: var(--space-5);
	}
	.group__title {
		margin-bottom: var(--space-3);
	}
	/* Icon grid, phone-home-screen style (compact, and auto when narrow). */
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
		gap: var(--space-4) var(--space-2);
	}
	.all:not([data-foldable]) > .all__toggle {
		display: none;
	}
	.all__toggle {
		list-style: none;
	}
	.all__toggle::-webkit-details-marker {
		display: none;
	}
	.all__toggle::after {
		content: "+";
		font-family: var(--font-mono);
		color: var(--comment);
	}
	.all[open] > .all__toggle::after {
		content: "\2212";
	}
	.all[data-foldable][open] > .groups {
		margin-top: var(--space-5);
	}

	/* Detailed: rows separated by hairlines, as many columns as fit. */
	.apps[data-view="detailed"] .grid {
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 0 var(--space-6);
	}
	.apps[data-view="detailed"] .grid > li {
		border-bottom: var(--hairline) solid var(--line);
	}
	@container apps (min-width: 520px) and (max-width: 899px) {
		.apps[data-view="auto"] .grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 var(--space-6);
		}
		.apps[data-view="auto"] .grid > li {
			border-bottom: var(--hairline) solid var(--line);
		}
	}

	/*
	 * Full desktop width (the strip above the feed): icon sections sit side by
	 * side and wrap, so a few apps take one short row and many stay compact.
	 */
	@container apps (min-width: 900px) {
		.apps:not([data-view="detailed"]) .groups {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-5) var(--space-7);
		}
		.apps:not([data-view="detailed"]) .group + .group {
			margin-top: 0;
		}
		.apps:not([data-view="detailed"]) .grid {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-3) var(--space-1);
		}
		.apps:not([data-view="detailed"]) .grid > li {
			width: 84px;
		}
	}
</style>
