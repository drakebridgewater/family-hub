---
/**
 * Manage the app launcher for everyone (ADMIN_GROUPS only). Every change is a
 * small same-origin form post that edits the catalog and redirects back, so
 * it works without JavaScript.
 */
import Base from "../../layouts/Base.astro";
import AppFields from "../../components/AppFields.astro";
import AppIcon from "../../components/AppIcon.astro";
import Icon from "../../components/brand/Icon.astro";
import { getFamilyUser } from "../../lib/auth";
import { EDITOR_ROLE_GROUPS } from "../../lib/editor-roles";
import {
	ADMIN_GROUPS,
	getCatalog,
	isAppAdmin,
	newId,
	normalizeService,
	parseGroups,
	saveCatalog,
	type ServiceSection,
} from "../../lib/services";

const user = await getFamilyUser(Astro.request);
if (!user) return Astro.redirect("/login", 302);
Astro.response.headers.set("Cache-Control", "private, no-store");
if (!isAppAdmin(user)) {
	return new Response(`Only members of ${ADMIN_GROUPS.join(" or ")} can manage apps.`, { status: 403 });
}

if (Astro.request.method === "POST") {
	// Same-origin form posts only (the site is public, so guard against CSRF).
	const siteOrigin = new URL(process.env.EMDASH_SITE_URL ?? Astro.url.origin).origin;
	if (Astro.request.headers.get("origin") !== siteOrigin) return new Response("Forbidden", { status: 403 });

	const form = await Astro.request.formData();
	const get = (key: string) => String(form.get(key) ?? "").trim();
	const back = (anchor: string, error?: string) =>
		Astro.redirect(`/admin/apps${error ? `?error=${encodeURIComponent(error)}` : "?saved=1"}${anchor ? `#${anchor}` : ""}`, 303);

	const sections: ServiceSection[] = structuredClone((await getCatalog()).sections);
	const section = sections.find((s) => s.id === get("section"));
	const findApp = () => {
		for (const s of sections) {
			const i = s.services.findIndex((svc) => svc.id === get("app"));
			if (i >= 0) return { list: s.services, i };
		}
		return null;
	};
	const appFromForm = (id: string) =>
		normalizeService(
			{
				id,
				name: get("name"),
				url: get("url"),
				icon: get("icon"),
				description: get("description"),
				groups: [...form.getAll("groups").map(String), ...parseGroups(get("otherGroups"))],
				policy: get("policy"),
			},
			id,
		);
	const move = <T,>(list: T[], i: number, dir: string) => {
		const j = dir === "up" ? i - 1 : i + 1;
		if (j >= 0 && j < list.length) [list[i], list[j]] = [list[j], list[i]];
	};
	const INVALID = "An app needs a name and a web address starting with https:// (or a /path on this site).";

	let anchor = "";
	switch (get("do")) {
		case "add-section": {
			const id = newId();
			sections.push({ id, title: get("title").slice(0, 60) || "New section", services: [] });
			anchor = `section-${id}`;
			break;
		}
		case "rename-section":
			if (!section) return back("", "That section no longer exists.");
			section.title = get("title").slice(0, 60);
			anchor = `section-${section.id}`;
			break;
		case "move-section": {
			const i = sections.findIndex((s) => s === section);
			if (i < 0) return back("", "That section no longer exists.");
			move(sections, i, get("dir"));
			anchor = `section-${section!.id}`;
			break;
		}
		case "delete-section": {
			const i = sections.findIndex((s) => s === section);
			if (i >= 0) sections.splice(i, 1);
			break;
		}
		case "add-app": {
			if (!section) return back("", "That section no longer exists.");
			const app = appFromForm(newId());
			if (!app) return back(`section-${section.id}`, INVALID);
			section.services.push(app);
			anchor = `app-${app.id}`;
			break;
		}
		case "update-app": {
			const found = findApp();
			if (!found) return back("", "That app no longer exists.");
			const app = appFromForm(found.list[found.i].id);
			if (!app) return back(`app-${get("app")}`, INVALID);
			const target = sections.find((s) => s.id === get("moveTo"));
			if (target && !target.services.includes(found.list[found.i])) {
				found.list.splice(found.i, 1);
				target.services.push(app);
			} else {
				found.list[found.i] = app;
			}
			anchor = `app-${app.id}`;
			break;
		}
		case "move-app": {
			const found = findApp();
			if (!found) return back("", "That app no longer exists.");
			move(found.list, found.i, get("dir"));
			anchor = `app-${get("app")}`;
			break;
		}
		case "delete-app": {
			const found = findApp();
			if (found) found.list.splice(found.i, 1);
			break;
		}
		default:
			return back("", "Unknown action.");
	}

	try {
		await saveCatalog(sections, user.username);
	} catch (err) {
		console.error("[family-hub] Saving apps failed:", err);
		return back(anchor, "Couldn't save. Check the database connection and try again.");
	}
	return back(anchor);
}

const catalog = await getCatalog();
const sections = catalog.sections;
const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.has("saved");
const knownGroups = [
	...new Set([
		...sections.flatMap((s) => s.services.flatMap((svc) => svc.groups ?? [])),
		...EDITOR_ROLE_GROUPS.map(([g]) => g),
		...user.groups,
	]),
].sort();
// A word with each state, never a bare color. Shown (optional) needs no label.
const policyStatus = {
	always: { state: "ok", label: "always shown" },
	hidden: { state: "off", label: "hidden" },
	optional: null,
} as const;
---

<Base title="Manage apps" user={user} path={["admin", "apps"]}>
	<h1>Manage apps</h1>
	<p class="sub bw-soft">The app list everyone sees. Changes apply right away.</p>

	{error && <p class="bw-panel flash" data-role="red" role="alert">{error}</p>}
	{saved && !error && <p class="bw-panel flash" data-role="green" role="status">Saved.</p>}
	{
		catalog.source === "file" && (
			<p class="note">
				These apps come from <code>config/services.yaml</code>. Your first change here copies them into the database, and
				from then on this page is the place to edit them.
			</p>
		)
	}

	<div class="sections">
		{
			sections.map((section, si) => (
				<section class="sec" id={`section-${section.id}`}>
					<div class="sec__head">
						<form method="post" class="sec__rename">
							<input type="hidden" name="do" value="rename-section" />
							<input type="hidden" name="section" value={section.id} />
							<input name="title" value={section.title} maxlength="60" aria-label="Section name" placeholder="Section name" />
							<button class="bw-btn bw-btn--secondary bw-btn--sm">Save</button>
						</form>
						<form method="post" class="tools">
							<input type="hidden" name="do" value="move-section" />
							<input type="hidden" name="section" value={section.id} />
							<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon" name="dir" value="up" disabled={si === 0} aria-label="Move section up">↑</button>
							<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon" name="dir" value="down" disabled={si === sections.length - 1} aria-label="Move section down">↓</button>
						</form>
						<form method="post" data-confirm={section.services.length ? `Delete "${section.title}" and its ${section.services.length} app(s)?` : undefined}>
							<input type="hidden" name="do" value="delete-section" />
							<input type="hidden" name="section" value={section.id} />
							<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon danger-icon" aria-label={`Delete section ${section.title}`} title="Delete section">
								<Icon name="close" size={16} />
							</button>
						</form>
					</div>

					<ul class="apps" role="list">
						{section.services.map((svc, ai) => (
							<li class="app" id={`app-${svc.id}`} data-policy={svc.policy}>
								<div class="app__row">
									<AppIcon name={svc.name} icon={svc.icon} size={36} lazy />
									<span class="app__info">
										<span class="app__name">{svc.name}</span>
										<span class="app__url bw-mono">{svc.url}</span>
										<span class="badges">
											{policyStatus[svc.policy] && (
												<span class="bw-status" data-state={policyStatus[svc.policy]!.state}>{policyStatus[svc.policy]!.label}</span>
											)}
											<span class="app__groups bw-mono">{svc.groups?.length ? svc.groups.join(" ") : "everyone"}</span>
										</span>
									</span>
									<form method="post" class="tools">
										<input type="hidden" name="do" value="move-app" />
										<input type="hidden" name="app" value={svc.id} />
										<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon" name="dir" value="up" disabled={ai === 0} aria-label={`Move ${svc.name} up`}>↑</button>
										<button class="bw-btn bw-btn--secondary bw-btn--sm bw-btn--icon" name="dir" value="down" disabled={ai === section.services.length - 1} aria-label={`Move ${svc.name} down`}>↓</button>
									</form>
								</div>
								<details class="edit">
									<summary>Edit</summary>
									<form method="post" class="edit__form">
										<input type="hidden" name="app" value={svc.id} />
										<AppFields svc={svc} sections={sections} sectionId={section.id} knownGroups={knownGroups} />
										<div class="edit__actions">
											<button class="bw-btn bw-btn--primary bw-btn--sm" name="do" value="update-app">Save</button>
											<button
												class="bw-btn bw-btn--danger bw-btn--sm"
												name="do"
												value="delete-app"
												formnovalidate
												data-confirm={`Delete ${svc.name}?`}
											>
												Delete
											</button>
										</div>
									</form>
								</details>
							</li>
						))}
					</ul>

					<details class="add" open={section.services.length === 0}>
						<summary>Add an app to {section.title || "this section"}</summary>
						<form method="post" class="edit__form">
							<input type="hidden" name="do" value="add-app" />
							<input type="hidden" name="section" value={section.id} />
							<AppFields sectionId={section.id} knownGroups={knownGroups} />
							<div class="edit__actions">
								<button class="bw-btn bw-btn--primary bw-btn--sm">Add app</button>
							</div>
						</form>
					</details>
				</section>
			))
		}
	</div>

	<form method="post" class="newsec">
		<input type="hidden" name="do" value="add-section" />
		<label for="new-section" class="bw-field__label">New section</label>
		<div class="newsec__row">
			<input id="new-section" class="bw-field__control" name="title" maxlength="60" placeholder="Games" required />
			<button class="bw-btn bw-btn--secondary">Add section</button>
		</div>
	</form>

	<p class="note">
		Who sees an app is a convenience, not security: each app still needs its own Authelia rule. People can star
		favorites and hide "Shown" apps for themselves on <a href="/settings#apps">Customize home</a>.
	</p>
</Base>

<script>
	// Confirm deletes (a form's data-confirm, or the button that submitted it).
	document.addEventListener("submit", (event) => {
		const form = event.target as HTMLFormElement;
		const submitter = (event as SubmitEvent).submitter as HTMLElement | null;
		const message = submitter?.dataset.confirm ?? form.dataset.confirm;
		if (message && !confirm(message)) event.preventDefault();
	});
</script>

<style>
	.sub {
		margin-top: var(--space-2);
	}
	.flash {
		margin-top: var(--space-5);
		padding: var(--space-3) var(--space-4);
	}
	.note {
		margin-top: var(--space-5);
		color: var(--comment);
		font-size: 14px;
		line-height: 22px;
		max-width: var(--measure);
	}
	.sections {
		margin-top: var(--space-5);
	}
	/* Sections are separated by an ink rule and space; apps inside by hairlines. */
	.sec {
		padding: var(--space-4) 0 var(--space-5);
		border-top: var(--rule) solid var(--ink);
	}
	.sec + .sec {
		margin-top: var(--space-5);
	}
	.sec__head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.sec__rename {
		flex: 1;
		display: flex;
		align-items: center;
		gap: var(--space-2);
		min-width: 0;
	}
	.sec__rename input {
		flex: 1;
		min-width: 0;
		min-height: var(--control);
		padding: 0 var(--space-2);
		margin-left: calc(-1 * var(--space-2));
		border: var(--field-border) solid transparent;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--ink);
		font: 600 24px/30px var(--font-sans);
	}
	.sec__rename input:hover,
	.sec__rename input:focus {
		border-color: var(--line-strong);
	}
	.tools {
		display: flex;
		gap: var(--space-1);
	}
	.tools .bw-btn {
		font-family: var(--font-mono);
	}
	.danger-icon:hover {
		color: var(--red);
		border-color: var(--red);
	}
	.apps {
		list-style: none;
		margin: var(--space-3) 0 0;
		padding: 0;
	}
	.app {
		border-top: var(--hairline) solid var(--line);
		padding: var(--space-3) 0 var(--space-1);
	}
	.app__row {
		display: grid;
		grid-template-columns: 36px 1fr auto;
		align-items: center;
		gap: var(--space-3);
	}
	.app__info {
		display: grid;
		min-width: 0;
	}
	.app__name {
		font-weight: 500;
	}
	/* Hidden from everyone: grey, never faded. */
	.app[data-policy="hidden"] .app__name {
		color: var(--comment);
	}
	.app__url {
		color: var(--comment);
		font-size: 12.5px;
		line-height: 18px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1) var(--space-3);
		margin-top: var(--space-1);
	}
	.app__groups {
		color: var(--comment);
		font-size: 12.5px;
		line-height: 18px;
	}
	.edit > summary,
	.add > summary {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		margin-left: calc(36px + var(--space-3));
		color: var(--teal);
		font-size: 14px;
		cursor: pointer;
		list-style: none;
	}
	.edit > summary:hover,
	.add > summary:hover {
		text-decoration: underline;
	}
	.edit > summary::-webkit-details-marker,
	.add > summary::-webkit-details-marker {
		display: none;
	}
	.edit[open] > summary {
		color: var(--comment);
	}
	.add {
		border-top: var(--hairline) solid var(--line);
		padding-top: var(--space-2);
	}
	.add > summary {
		margin-left: 0;
	}
	.add > summary::before {
		content: "+";
		font-family: var(--font-mono);
		margin-right: var(--space-2);
	}
	.edit__form {
		margin: var(--space-2) 0 var(--space-4);
		padding: var(--space-4);
		border-radius: var(--radius-md);
		background: var(--panel);
	}
	.edit__actions {
		display: flex;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}
	.newsec {
		display: grid;
		gap: var(--space-1);
		margin-top: var(--space-5);
		padding-top: var(--space-4);
		border-top: var(--rule) solid var(--ink);
	}
	.newsec__row {
		display: flex;
		gap: var(--space-2);
	}
</style>
