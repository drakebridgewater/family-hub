---
import type { MobileApps } from "../lib/prefs";
import type { Service } from "../lib/services";
import { resolveIcon } from "../lib/services";

interface Props {
	svc: Service;
	/** Which phone-app store buttons to offer; "auto" ones start hidden until ServiceGrid detects the OS. */
	mobileApps?: MobileApps;
}
const { svc, mobileApps = "auto" } = Astro.props;
const icon = resolveIcon(svc.icon);
const stores = (
	[
		{ os: "ios", url: svc.ios, where: "the App Store" },
		{ os: "android", url: svc.android, where: "Google Play" },
	] as const
).filter((s) => s.url && (mobileApps === "auto" || mobileApps === s.os));
---

<a class="tile" href={svc.url} rel="noopener" title={svc.description}>
	<span class="tile__icon" aria-hidden="true">
		{icon.kind === "img" ? <img src={icon.value} alt="" width="40" height="40" decoding="async" /> : icon.value}
	</span>
	<span class="tile__name">{svc.name}</span>
	{svc.description && <span class="tile__desc">{svc.description}</span>}
</a>
{
	stores.map((s) => (
		<a
			class="store"
			data-os={s.os}
			href={s.url}
			rel="noopener"
			hidden={mobileApps === "auto"}
			title={`Get ${svc.name} from ${s.where}`}
			aria-label={`Get the ${svc.name} app from ${s.where}`}
		>
			<span aria-hidden="true">↓</span> Get app
		</a>
	))
}

<style>
	/* Laid out by the .apps container in ServiceGrid (data-view + its width). */
	.tile {
		display: grid;
		justify-items: center;
		gap: 6px;
		text-align: center;
		text-decoration: none;
		padding: 4px 0;
		border-radius: var(--radius-sm);
		-webkit-tap-highlight-color: transparent;
	}
	.tile__icon {
		width: 60px;
		height: 60px;
		border-radius: 16px;
		display: grid;
		place-items: center;
		font-size: 1.8rem;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		transition: transform 0.15s ease;
	}
	.tile:hover .tile__icon {
		border-color: var(--accent);
	}
	.tile:active .tile__icon {
		transform: scale(0.92);
	}
	.tile__icon img {
		width: 38px;
		height: 38px;
		object-fit: contain;
	}
	.tile__name {
		max-width: 100%;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tile__desc {
		display: none;
	}

	/* Phone-app store button, under the icon (or at the right of a detailed row). */
	.store {
		align-self: center;
		display: inline-flex;
		align-items: center;
		gap: 3px;
		min-height: 26px;
		padding: 0 9px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--text);
		font-size: 0.7rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.store[hidden] {
		display: none;
	}
	.store:hover {
		border-color: var(--accent);
	}
	.store span {
		color: var(--accent);
	}
	:global(.apps .grid > li:has(> .store:not([hidden]))) {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	:global(.apps[data-view="detailed"] .grid > li) {
		position: relative;
	}
	:global(.apps[data-view="detailed"] .grid > li > .store) {
		position: absolute;
		top: 8px;
		right: 8px;
		min-height: 22px;
	}
	:global(.apps[data-view="detailed"] .grid > li:has(> .store:not([hidden])) .tile__name) {
		padding-right: 76px;
	}

	/* Detailed rows: always for "detailed"; for "auto" at in-between widths (tablet apps tab). */
	:global(.apps[data-view="detailed"]) .tile {
		grid-template-columns: 44px 1fr;
		grid-template-rows: auto auto;
		justify-items: start;
		align-items: center;
		column-gap: 12px;
		row-gap: 0;
		text-align: left;
		padding: 10px 12px;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	:global(.apps[data-view="detailed"]) .tile:hover {
		border-color: var(--accent);
	}
	:global(.apps[data-view="detailed"]) .tile__icon {
		grid-row: span 2;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		box-shadow: none;
		background: var(--surface-2);
		border: 0;
	}
	:global(.apps[data-view="detailed"]) .tile__icon img {
		width: 30px;
		height: 30px;
	}
	:global(.apps[data-view="detailed"]) .tile__name {
		font-size: 0.95rem;
		align-self: end;
		white-space: normal;
	}
	:global(.apps[data-view="detailed"]) .tile__desc {
		display: block;
		font-size: 0.8rem;
		color: var(--muted);
		align-self: start;
	}
	@container apps (min-width: 520px) and (max-width: 899px) {
		:global(.apps[data-view="auto"]) .tile {
			grid-template-columns: 44px 1fr;
			grid-template-rows: auto auto;
			justify-items: start;
			align-items: center;
			column-gap: 12px;
			row-gap: 0;
			text-align: left;
			padding: 10px 12px;
			background: var(--surface);
			border: 1px solid var(--line);
		}
		:global(.apps[data-view="auto"]) .tile:hover {
			border-color: var(--accent);
		}
		:global(.apps[data-view="auto"]) .tile__icon {
			grid-row: span 2;
			width: 44px;
			height: 44px;
			border-radius: 12px;
			box-shadow: none;
			background: var(--surface-2);
			border: 0;
		}
		:global(.apps[data-view="auto"]) .tile__icon img {
			width: 30px;
			height: 30px;
		}
		:global(.apps[data-view="auto"]) .tile__name {
			font-size: 0.95rem;
			align-self: end;
			white-space: normal;
		}
		:global(.apps[data-view="auto"]) .tile__desc {
			display: block;
			font-size: 0.8rem;
			color: var(--muted);
			align-self: start;
		}
		:global(.apps[data-view="auto"] .grid > li) {
			position: relative;
		}
		:global(.apps[data-view="auto"] .grid > li > .store) {
			position: absolute;
			top: 8px;
			right: 8px;
			min-height: 22px;
		}
		:global(.apps[data-view="auto"] .grid > li:has(> .store:not([hidden])) .tile__name) {
			padding-right: 76px;
		}
	}
</style>
