---
import { getMenu, getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import type { FamilyUser } from "../lib/auth";
import { logoutUrl, securityUrl } from "../lib/auth";
import { canPost, EDITOR_URL } from "../lib/editor-roles";
import { isAppAdmin, launcherFor, type Launcher } from "../lib/services";
import AppLauncher from "../components/AppLauncher.astro";
import Icon from "../components/brand/Icon.astro";
import Prompt, { type PathSeg } from "../components/brand/Prompt.astro";
import Skyline from "../components/brand/Skyline.astro";
import ThemeToggle from "../components/brand/ThemeToggle.astro";
import Wordmark from "../components/brand/Wordmark.astro";
import "@fontsource/fira-sans/400.css";
import "@fontsource/fira-sans/500.css";
import "@fontsource/fira-sans/600.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/500.css";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	user?: FamilyUser | null;
	/**
	 * Bottom tab bar (home page only). On phones each tab shows one panel of
	 * the page; on desktop everything is visible and the bar is hidden.
	 */
	tabs?: Array<{ id: string; label: string; icon: Parameters<typeof Icon>[0]["name"] }>;
	/** Tab shown first on phones. */
	activeTab?: string;
	/** Wider frame for the two-column desktop home page. */
	wide?: boolean;
	/** Breadcrumb after ~ in the prompt line, e.g. ["settings"] or [{ label: "tag", href: "/tag" }, "summer"]. */
	path?: PathSeg[];
	/** The skyline illustration above the footer: the home page only. */
	skyline?: boolean;
	/**
	 * EmDash page context (SEO tags, plugin contributions). Content pages pass
	 * one built from their entry; everything else gets a plain one.
	 */
	page?: Parameters<typeof EmDashHead>[0]["page"];
	/** The signed-in person's apps, if the page already loaded them (else loaded here). */
	launcher?: Launcher;
}

const { title, description, user = null, tabs = [], activeTab, wide = false, path = [], skyline = false } = Astro.props;
const [settings, menu] = await Promise.all([getSiteSettings(), getMenu("primary")]);
const menuItems = menu?.items ?? [];
const siteTitle = settings?.title || "The Bridgewaters";
const tagline = settings?.tagline || "";
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const page =
	Astro.props.page ??
	createPublicPageContext({ Astro, kind: "custom", title: title ?? siteTitle, description: description ?? tagline, siteName: siteTitle });
const isCurrent = (url: string) => url === Astro.url.pathname;
const launcher = user ? (Astro.props.launcher ?? (await launcherFor(user))) : null;

// The prompt names this app by its host (social.bridgewater.digital -> "social").
const appName = (() => {
	try {
		return new URL(process.env.EMDASH_SITE_URL ?? "").hostname.split(".")[0] || "social";
	} catch {
		return "social";
	}
})();
const firstName = user?.name.split(" ")[0] || user?.username;
---

<!doctype html>
<html lang="en" data-sig="green">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#fafcfc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a1b1e" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		{/* Before paint: the saved theme, else the system's (same key as the bundle's ThemeToggle). */}
		<script is:inline>
			(function () {
				var t = null;
				try {
					t = localStorage.getItem("bw-theme");
				} catch (e) {}
				if (t !== "dark" && t !== "light") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				document.documentElement.setAttribute("data-theme", t);
			})();
		</script>
		{!settings?.favicon && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{pageTitle}</title>
		<EmDashHead page={page} />
	</head>
	<body class:list={{ "has-tabs": tabs.length > 0, wide }} data-tab={tabs.length ? activeTab ?? tabs[0].id : undefined}>
		<EmDashBodyStart page={page} />
		<header class="bw-header">
			<div class="bw-strip" aria-hidden="true"></div>
			<div class="frame bw-header__bar">
				<Wordmark href="/" />
				<ThemeToggle />
			</div>
			<div class="bw-header__rule"></div>
			<div class="frame bw-header__where where">
				<Prompt user={user?.username ?? "you"} app={{ label: appName, href: "/" }} userHref="/" path={path} />
				<div class="where__tools">
					{launcher && <AppLauncher launcher={launcher} />}
					{
						user ? (
							<details class="account">
								<summary class="bw-btn bw-btn--secondary bw-btn--sm" aria-label={`Account menu for ${user.name}`}>
									{firstName}
								</summary>
								<div class="account__menu popover">
									<p class="account__who">
										<strong>{user.name}</strong>
										<span class="bw-mono">{user.email || user.username}</span>
									</p>
									{canPost(user.groups) && (
										<a href={EDITOR_URL} class="bw-btn bw-btn--secondary">Write and edit</a>
									)}
									<a href="/settings" class="bw-btn bw-btn--quiet">Customize home</a>
									{isAppAdmin(user) && <a href="/admin/apps" class="bw-btn bw-btn--quiet">Manage apps</a>}
									<a href={securityUrl()} class="bw-btn bw-btn--quiet">Password and security</a>
									<a href={logoutUrl()} class="bw-btn bw-btn--quiet">Sign out</a>
								</div>
							</details>
						) : (
							<a href="/login" class="bw-btn bw-btn--secondary bw-btn--sm">Sign in</a>
						)
					}
				</div>
			</div>
		</header>

		{
			menuItems.length > 0 && (
				<nav class="frame sitenav" aria-label={menu?.label ?? "Site"}>
					<ul role="list">
						{menuItems.map((item) => (
							<li>
								{item.children.length ? (
									<details class="sitenav__sub">
										<summary>{item.label}</summary>
										<ul class="popover sitenav__panel" role="list">
											<li>
												<a href={item.url} target={item.target || undefined} rel={item.target === "_blank" ? "noopener" : undefined}>
													{item.label}
												</a>
											</li>
											{item.children.map((child) => (
												<li>
													<a href={child.url} target={child.target || undefined} rel={child.target === "_blank" ? "noopener" : undefined} title={child.titleAttr || undefined} class={child.cssClasses || undefined}>
														{child.label}
													</a>
												</li>
											))}
										</ul>
									</details>
								) : (
									<a
										href={item.url}
										target={item.target || undefined}
										rel={item.target === "_blank" ? "noopener" : undefined}
										title={item.titleAttr || undefined}
										class={item.cssClasses || undefined}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										{item.label}
									</a>
								)}
							</li>
						))}
					</ul>
				</nav>
			)
		}

		<main class="frame main">
			<slot />
		</main>

		{skyline && (
			<div class="frame skyline">
				<Skyline />
			</div>
		)}

		<footer class="frame footer">
			<p>{tagline}</p>
		</footer>

		{
			tabs.length > 0 && (
				<nav class="tabbar" aria-label="Sections">
					{tabs.map((t) => (
						<a
							href={`/?tab=${t.id}`}
							class="tabbar__item"
							data-tab-link={t.id}
							aria-current={(activeTab ?? tabs[0].id) === t.id ? "page" : undefined}
						>
							<Icon name={t.icon} size={22} />
							<span>{t.label}</span>
						</a>
					))}
				</nav>
			)
		}
		{
			tabs.length > 0 && (
				<script>
					// Switch panels in place instead of reloading (the links still work without JS).
					for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-tab-link]")) {
						link.addEventListener("click", (event) => {
							const tab = link.dataset.tabLink!;
							event.preventDefault();
							document.body.dataset.tab = tab;
							for (const other of document.querySelectorAll("[data-tab-link]")) {
								other.toggleAttribute("aria-current", other === link);
								if (other === link) other.setAttribute("aria-current", "page");
							}
							history.replaceState(null, "", `/?tab=${tab}`);
							window.scrollTo({ top: 0 });
						});
					}
				</script>
			)
		}
		<EmDashBodyEnd page={page} />
	</body>
</html>

<style>
	.bw-header__bar :global(.bw-lt) {
		height: 28px;
		width: auto;
	}
	@media (max-width: 559px) {
		.bw-header__bar :global(.bw-lt) {
			height: 22px;
		}
	}
	.where {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.where__tools {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-shrink: 0;
	}
	.account {
		position: relative;
	}
	.account > summary {
		list-style: none;
	}
	.account > summary::-webkit-details-marker {
		display: none;
	}
	.account__menu {
		position: absolute;
		right: 0;
		top: calc(100% + var(--space-2));
		z-index: 30;
		width: min(280px, calc(100vw - 32px));
		padding: var(--space-4);
		display: grid;
		gap: var(--space-1);
	}
	.account__menu .bw-btn {
		justify-content: flex-start;
	}
	.account__who {
		display: grid;
		margin-bottom: var(--space-3);
	}
	.account__who span {
		color: var(--comment);
		font-size: 14px;
		overflow-wrap: anywhere;
	}
	.sitenav {
		padding-top: var(--space-3);
	}
	.sitenav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sitenav > ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-5);
	}
	.sitenav a,
	.sitenav summary {
		color: var(--teal);
		text-decoration: none;
		cursor: pointer;
	}
	.sitenav a:hover,
	.sitenav summary:hover,
	.sitenav a[aria-current="page"] {
		text-decoration: underline;
		text-decoration-thickness: var(--hairline);
		text-underline-offset: 3px;
	}
	.sitenav__sub {
		position: relative;
	}
	.sitenav__sub > summary {
		list-style: none;
	}
	.sitenav__sub > summary::-webkit-details-marker {
		display: none;
	}
	.sitenav__panel {
		position: absolute;
		left: 0;
		top: calc(100% + var(--space-2));
		z-index: 30;
		min-width: 220px;
		max-width: calc(100vw - 32px);
		padding: var(--space-2) var(--space-4);
	}
	.sitenav__panel a {
		display: block;
		padding: var(--space-2) 0;
	}
	.wide {
		--max: var(--page-max);
	}
	.main {
		padding-top: var(--space-5);
		padding-bottom: var(--space-6);
	}
	.skyline {
		margin-top: var(--space-6);
	}
	.footer {
		color: var(--comment);
		font-size: 14px;
		line-height: 22px;
		padding-top: var(--space-4);
		padding-bottom: var(--space-6);
	}
	.has-tabs .footer {
		padding-bottom: calc(var(--nav-h) + var(--space-6) + env(safe-area-inset-bottom));
	}
	.tabbar {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 20;
		display: flex;
		justify-content: space-around;
		background: var(--page);
		border-top: var(--hairline) solid var(--line-strong);
		padding-bottom: env(safe-area-inset-bottom);
	}
	.tabbar__item {
		flex: 1;
		min-height: var(--nav-h);
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 2px;
		font: 500 12.5px/18px var(--font-sans);
		color: var(--comment);
		text-decoration: none;
	}
	.tabbar__item[aria-current="page"] {
		color: var(--sig);
	}
	/* On wider screens the tab bar is unnecessary: everything fits. */
	@media (min-width: 900px) {
		.tabbar {
			display: none;
		}
		.has-tabs .footer {
			padding-bottom: var(--space-6);
		}
	}
</style>
