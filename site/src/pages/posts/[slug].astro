---
import { getEmDashEntry, decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import { createPublicPageContext } from "emdash/page";
import Terms from "../../components/Terms.astro";
import { getFamilyUser } from "../../lib/auth";
import { termsForPost } from "../../lib/terms";
import { isMembersOnly } from "../../lib/visibility";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: post }, user] = await Promise.all([getEmDashEntry("posts", slug), getFamilyUser(Astro.request)]);
if (!post) return Astro.rewrite("/404");

Astro.response.headers.set("Cache-Control", "private, no-store");

// Family-only post and nobody signed in: say so, without leaking the title.
const locked = isMembersOnly(post) && !user;
if (locked) Astro.response.status = 403;
const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname)}`;

const published = post.data.publishedAt ?? post.data.createdAt;
const dateLabel = published
	? new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(new Date(published))
	: "";
const author = post.data.bylines?.[0]?.byline?.displayName ?? "The Bridgewaters";
const terms = locked ? undefined : await termsForPost(post.data.id);

// Locked pages get a bare context so SEO tags can't leak the title/excerpt.
const page = locked
	? createPublicPageContext({ Astro, kind: "custom", title: "Family only", seo: { robots: "noindex" } })
	: createPublicPageContext({
			Astro,
			kind: "content",
			pageType: "article",
			title: post.data.title,
			description: post.data.excerpt,
			content: { collection: "posts", id: post.data.id, slug },
			articleMeta: {
				publishedTime: published ? new Date(published).toISOString() : null,
				author,
			},
		});
---

{
	locked ? (
		<Base title="Family only" user={user} page={page}>
			<a href="/" class="back">← Back to the feed</a>
			<section class="card locked">
				<p class="locked__icon" aria-hidden="true">🔒</p>
				<h1 class="locked__title">This post is just for family</h1>
				<p class="locked__sub">Sign in with your family account to read it.</p>
				<a href={loginHref} class="btn">Sign in</a>
			</section>
		</Base>
	) : (
		<Base title={post.data.title} description={post.data.excerpt} user={user} page={page}>
			<a href="/" class="back">← Back to the feed</a>

			<article class="article card">
				{
					post.data.featured_image && (
						<div class="article__media" {...post.edit.featured_image}>
							<Image image={post.data.featured_image} sizes="(min-width: 640px) 608px, 100vw" priority />
						</div>
					)
				}
				<div class="article__body">
					<p class="article__meta">{author} · {dateLabel}</p>
					<h1 class="article__title" {...post.edit.title}>{post.data.title}</h1>
					<div class="prose">
						<PortableText value={post.data.content} />
					</div>
					<div class="article__terms">
						<Terms terms={terms} />
					</div>
				</div>
			</article>

			<section id="comments" class="section">
				<div class="section__head">
					<h2 class="section__title">Comments</h2>
				</div>
				<div class="card comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</section>
		</Base>
	)
}

<style>
	.locked {
		margin-top: 8px;
		padding: 28px 20px;
		text-align: center;
	}
	.locked__icon {
		margin: 0;
		font-size: 2rem;
	}
	.locked__title {
		font-family: var(--font-serif);
		font-size: 1.5rem;
		margin: 8px 0 0;
	}
	.locked__sub {
		margin: 6px 0 18px;
		color: var(--muted);
	}
	.article__terms {
		margin-top: 18px;
	}
	.comments {
		padding: 16px;
	}
	.comments :global(input),
	.comments :global(textarea) {
		width: 100%;
		font: inherit;
		font-size: 16px; /* prevents iOS zoom-on-focus */
	}
</style>
