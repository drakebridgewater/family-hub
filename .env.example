# Copy to .env and fill in. Never commit .env.

SITE_HOST=social.example.com
TZ=America/Los_Angeles
PUID=99
PGID=100

# Where volumes live on Unraid, and where the ./site folder is (for the build)
APPDATA=/mnt/user/appdata/family-hub
BUILD_CONTEXT=./site

# Generate with:  docker run --rm family-hub:latest npx emdash secrets generate
#   (or locally: cd site && npx emdash secrets generate)
# Format: emdash_enc_v1_<43 chars>. Back it up; losing it loses encrypted plugin secrets.
EMDASH_ENCRYPTION_KEY=

# --- Postgres (the stack's own family-hub-db container) ---
# family-hub-db creates the role and database from these on its first start.
# Keep the password URL-safe (openssl rand -hex 24).
DB_HOST=family-hub-db
DB_PORT=5432
DB_NAME=familyhub
DB_USER=familyhub
DB_PASSWORD=
# Where family-hub-db keeps its data, and the stack network's subnet (pick a free one)
DB_DATA=/mnt/cache/appdata/family-hub/db
DB_SUBNET=172.16.0.0/24

# --- Traefik: match your existing setup ---
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=cloudflare
AUTHELIA_MIDDLEWARE=default-secure@file

# --- Authelia ---
# The container must reach Authelia directly (same docker network)
AUTHELIA_INTERNAL_URL=http://authelia:9091
AUTHELIA_PUBLIC_URL=https://authelia.example.com
AUTHELIA_SESSION_COOKIE=authelia_session
# "Password & security" in the account menu. Default: ${AUTHELIA_PUBLIC_URL}/settings
ACCOUNT_SECURITY_URL=
# Comma-separated groups that can manage apps for everyone (/admin/apps)
ADMIN_GROUPS=admin

# --- Watch on your TV (/tv): approve a TV's Jellyfin Quick Connect code from the hub ---
# Leave JELLYFIN_API_KEY empty to turn the page off. Needs Jellyfin 10.9+ with Quick Connect on
# (Dashboard > General). Create the key in Dashboard > API Keys. It is a full Jellyfin admin
# credential, so keep this file private. Hub usernames must match Jellyfin usernames (any case).
JELLYFIN_INTERNAL_URL=http://jellyfin:8096
# The address people type into the TV app (the Streaming tile on this host gets a TV link)
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=

# --- Family schedule (iCal feeds, comma-separated "Label|URL") ---
# Google Calendar: Settings > your calendar > "Secret address in iCal format"
CALENDAR_FEEDS=
# members = only signed-in users see it (recommended); public = everyone
SCHEDULE_VISIBILITY=members
CALENDAR_DAYS_AHEAD=31

HOMEPAGE_GROUP=Family
