---
import { getEmDashEntry, decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import { createPublicPageContext } from "emdash/page";
import Terms from "../../components/Terms.astro";
import Icon from "../../components/brand/Icon.astro";
import { getFamilyUser } from "../../lib/auth";
import { termsForPost } from "../../lib/terms";
import { isMembersOnly } from "../../lib/visibility";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: post }, user] = await Promise.all([getEmDashEntry("posts", slug), getFamilyUser(Astro.request)]);
if (!post) return Astro.rewrite("/404");

Astro.response.headers.set("Cache-Control", "private, no-store");

// Family-only post and nobody signed in: say so, without leaking the title.
const locked = isMembersOnly(post) && !user;
if (locked) Astro.response.status = 403;
const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname)}`;

const published = post.data.publishedAt ?? post.data.createdAt;
const dateLabel = published
	? new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(new Date(published))
	: "";
const author = post.data.bylines?.[0]?.byline?.displayName ?? "The Bridgewaters";
const terms = locked ? undefined : await termsForPost(post.data.id);

// Locked pages get a bare context so SEO tags can't leak the title/excerpt.
const page = locked
	? createPublicPageContext({ Astro, kind: "custom", title: "Family only", seo: { robots: "noindex" } })
	: createPublicPageContext({
			Astro,
			kind: "content",
			pageType: "article",
			title: post.data.title,
			description: post.data.excerpt,
			content: { collection: "posts", id: post.data.id, slug },
			articleMeta: {
				publishedTime: published ? new Date(published).toISOString() : null,
				author,
			},
		});
---

{
	locked ? (
		<Base title="Family only" user={user} page={page} path={["posts", "family-only"]}>
			<section class="bw-focus locked">
				<Icon name="lock" size={24} />
				<h1>This post is for family</h1>
				<p class="bw-focus__lede">Sign in with your family account to read it.</p>
				<div class="bw-focus__actions">
					<a href={loginHref} class="bw-btn bw-btn--primary">Sign in</a>
				</div>
			</section>
		</Base>
	) : (
		<Base title={post.data.title} description={post.data.excerpt} user={user} page={page} path={["posts", slug]}>
			<article class="article reading">
				<div class="bw-pagehead">
					<div class="bw-pagehead__text">
						<h1 {...post.edit.title}>{post.data.title}</h1>
						<p class="bw-pagehead__meta">{author} · <time class="bw-mono">{dateLabel}</time></p>
					</div>
				</div>
				{
					post.data.featured_image && (
						<div class="article__media" {...post.edit.featured_image}>
							<Image image={post.data.featured_image} sizes="(min-width: 720px) 720px, 100vw" priority />
						</div>
					)
				}
				<div class="prose">
					<PortableText value={post.data.content} />
				</div>
				<div class="article__terms">
					<Terms terms={terms} />
				</div>
			</article>

			<section id="comments" class="bw-section comments reading">
				<div class="bw-section__head">
					<h2>Comments</h2>
				</div>
				<Comments collection="posts" contentId={post.data.id} threaded />
				<CommentForm collection="posts" contentId={post.data.id} />
			</section>
		</Base>
	)
}

<style>
	/* The lock is the private role. */
	.locked > :global(.bw-icon) {
		color: var(--teal);
		margin-bottom: var(--space-3);
	}
	.article__terms {
		margin-top: var(--space-5);
	}
	.comments {
		border-top: var(--hairline) solid var(--line);
		padding-top: var(--space-5);
	}
	/* EmDash's comments, themed through their custom properties. */
	.comments {
		--ec-form-bg: var(--page);
		--ec-form-color: var(--ink);
		--ec-form-border: var(--line-strong);
		--ec-form-submit-bg: var(--sig-fill);
		--ec-form-submit-color: var(--on-sig);
		--ec-form-user-bg: var(--panel);
		--ec-form-user-bg-dark: var(--panel);
		--ec-form-user-border: var(--line);
		--ec-form-success-color: var(--green);
		--ec-form-error-color: var(--red);
	}
	.comments :global(.ec-comments) {
		--ec-comment-border: var(--hairline) solid var(--line);
	}
	.comments :global(.ec-comment-form-field input),
	.comments :global(.ec-comment-form-field textarea) {
		border-width: var(--field-border);
		border-radius: var(--radius-sm);
		font: var(--type-body); /* 16px: prevents iOS zoom-on-focus */
	}
	.comments :global(.ec-comment-form-submit) {
		border-radius: var(--radius-sm);
		font: var(--type-label);
	}
</style>
