---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---

<Base title="Not found">
	<section class="bw-focus">
		<h1>Page not found</h1>
		<p class="bw-focus__lede">It may have been moved or unpublished.</p>
		<div class="bw-focus__actions">
			<a href="/" class="bw-btn bw-btn--primary">Back home</a>
		</div>
	</section>
</Base>
