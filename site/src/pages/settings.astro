---
import Base from "../layouts/Base.astro";
import { getFamilyUser } from "../lib/auth";
import AppIcon from "../components/AppIcon.astro";
import { isAppAdmin, prefMatches, servicesFor } from "../lib/services";
import { maxScheduleDays, scheduleEnabled } from "../lib/calendar";
import { DAY_CHOICES, getPrefs, savePrefs, type AppView, type HomeTab } from "../lib/prefs";

const user = await getFamilyUser(Astro.request);
if (!user) return Astro.redirect("/login", 302);

Astro.response.headers.set("Cache-Control", "private, no-store");

const sections = await servicesFor(user);
const allApps = sections.flatMap((s) => s.services);
const showSchedule = scheduleEnabled();
const dayChoices = DAY_CHOICES.filter((d) => d <= maxScheduleDays());

if (Astro.request.method === "POST") {
	// Same-origin form posts only (the page is public, so guard against CSRF).
	const siteOrigin = new URL(process.env.EMDASH_SITE_URL ?? Astro.url.origin).origin;
	const origin = Astro.request.headers.get("origin");
	if (origin !== siteOrigin) return new Response("Forbidden", { status: 403 });

	const form = await Astro.request.formData();
	const shown = new Set(form.getAll("show").map(String));
	const starred = new Set(form.getAll("pin").map(String));
	// Keep the order favorites were starred in; new ones go at the end.
	const before = (await getPrefs(user.username)).pinned;
	const pinned = [
		...before.filter((id) => starred.has(id)),
		...allApps.map((svc) => svc.id).filter((id) => starred.has(id) && !before.includes(id)),
	];
	await savePrefs(user.username, {
		hidden: allApps.filter((svc) => svc.policy !== "always" && !shown.has(svc.id)).map((svc) => svc.id),
		pinned,
		days: Number(form.get("days")),
		startTab: String(form.get("startTab")) as HomeTab,
		appView: String(form.get("appView")) as AppView,
	});
	return Astro.redirect("/", 303);
}

const prefs = await getPrefs(user.username);
const hidden = new Set(prefs.hidden);
const pinned = new Set(prefs.pinned);
const isAdmin = isAppAdmin(user);
const tabChoices: Array<{ id: HomeTab; label: string }> = [
	{ id: "feed", label: "Feed" },
	...(showSchedule ? [{ id: "schedule" as const, label: "Schedule" }] : []),
	{ id: "apps", label: "Apps" },
];
const viewChoices: Array<{ id: AppView; label: string }> = [
	{ id: "auto", label: "Automatic" },
	{ id: "compact", label: "Compact" },
	{ id: "detailed", label: "Detailed" },
];
const dayLabel = (d: number) => (d === 1 ? "Today" : `${d} days`);
---

<Base title="Customize" user={user} path={["settings"]}>
	<h1>Customize your home</h1>
	<p class="sub bw-soft">These settings are just for you, {user.name.split(" ")[0]}, and follow you to any device.</p>

	<form method="post" class="form">
		<fieldset class="group" id="start">
			<legend>Open to</legend>
			<p class="hint bw-field__hint">Which tab you land on when you open the hub on your phone.</p>
			<div class="chips">
				{
					tabChoices.map((t) => (
						<label class="chip">
							<input type="radio" name="startTab" value={t.id} checked={prefs.startTab === t.id} />
							<span>{t.label}</span>
						</label>
					))
				}
			</div>
		</fieldset>

		{
			showSchedule && (
				<fieldset class="group" id="days">
					<legend>Calendar</legend>
					<p class="hint bw-field__hint">How far ahead "Coming up" shows.</p>
					<div class="chips">
						{dayChoices.map((d) => (
							<label class="chip">
								<input type="radio" name="days" value={d} checked={prefs.days === d} />
								<span>{dayLabel(d)}</span>
							</label>
						))}
					</div>
				</fieldset>
			)
		}
		{!showSchedule && <input type="hidden" name="days" value={prefs.days} />}

		<fieldset class="group" id="apps">
			<legend>Apps</legend>
			<p class="hint bw-field__hint">
				Layout: Compact shows icons only, Detailed adds each app's description, Automatic picks by screen space.
			</p>
			<div class="chips chips--spaced">
				{
					viewChoices.map((v) => (
						<label class="chip">
							<input type="radio" name="appView" value={v.id} checked={prefs.appView === v.id} />
							<span>{v.label}</span>
						</label>
					))
				}
			</div>
			<p class="hint bw-field__hint">
				Star <span aria-hidden="true">★</span> your favorites to keep them up top (the rest fold under "All apps"), and turn
				off the ones you don't use.
				{isAdmin && <><br /><a href="/admin/apps">Manage apps for everyone</a></>}
			</p>
			{
				sections.map((section) => (
					<div class="apps-section">
						{section.title && <h2 class="label apps-section__title">{section.title}</h2>}
						<ul class="apps" role="list">
							{section.services.map((svc) => (
								<li>
									<div class="app">
										<AppIcon name={svc.name} icon={svc.icon} size={32} />
										<span class="app__name">
											{svc.name}
											{svc.policy === "always" && <span class="app__note">Always shown</span>}
										</span>
										<label class="star" title={`Favorite ${svc.name}`}>
											<input type="checkbox" name="pin" value={svc.id} checked={pinned.has(svc.id) || pinned.has(svc.url)} />
											<span aria-hidden="true">★</span>
											<span class="visually-hidden">Favorite {svc.name}</span>
										</label>
										<label class="show">
											<input
												type="checkbox"
												name="show"
												value={svc.id}
												checked={svc.policy === "always" || !prefMatches(hidden, svc)}
												disabled={svc.policy === "always"}
											/>
											<span>Show<span class="visually-hidden"> {svc.name}</span></span>
										</label>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</fieldset>

		<div class="actions">
			<button type="submit" class="bw-btn bw-btn--primary">Save</button>
			<a href="/" class="bw-btn bw-btn--secondary">Cancel</a>
		</div>
	</form>
</Base>

<style>
	.sub {
		margin-top: var(--space-2);
	}
	.form {
		margin-top: var(--space-5);
		border-top: var(--hairline) solid var(--line);
	}
	/* Each setting is a block separated by a hairline, not a card. */
	.group {
		margin: 0;
		padding: var(--space-5) 0;
		border: 0;
		border-bottom: var(--hairline) solid var(--line);
		min-width: 0;
	}
	legend {
		float: left;
		width: 100%;
		padding: 0;
		font-size: 18px;
		line-height: 26px;
		font-weight: 600;
	}
	.hint {
		clear: both;
		margin: var(--space-1) 0 var(--space-3);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.chips--spaced {
		margin-bottom: var(--space-5);
	}
	.chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.chip span {
		display: inline-flex;
		align-items: center;
		min-height: var(--control);
		padding: 0 var(--space-4);
		border: var(--field-border) solid var(--line-strong);
		border-radius: var(--radius-sm);
		font: 500 14px/20px var(--font-sans);
		cursor: pointer;
	}
	.chip span:hover {
		background: var(--panel);
	}
	/* Selected is green (the green role, which is also this site's signature). */
	.chip input:checked + span {
		background: var(--green-tint);
		border-color: var(--green);
	}
	.chip input:focus-visible + span {
		outline: var(--focus-width) solid var(--sig);
		outline-offset: 2px;
	}
	.apps-section + .apps-section {
		margin-top: var(--space-5);
	}
	.apps-section__title {
		margin-bottom: var(--space-1);
	}
	.apps {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--hairline) solid var(--line);
	}
	.apps li {
		border-bottom: var(--hairline) solid var(--line);
	}
	.app {
		display: grid;
		grid-template-columns: 32px 1fr auto auto;
		align-items: center;
		gap: var(--space-3);
		min-height: 52px;
		padding: var(--space-2) 0;
	}
	.app__name {
		font-weight: 500;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.app__note {
		display: block;
		font: 400 12.5px/18px var(--font-mono);
		color: var(--comment);
	}
	.star {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--control);
		height: var(--control);
		border-radius: var(--radius-sm);
		font-size: 20px;
		color: var(--line-strong);
		cursor: pointer;
	}
	.star:hover {
		background: var(--panel);
	}
	.star input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.star:has(input:checked) {
		color: var(--sig);
	}
	.star:has(input:focus-visible) {
		outline: var(--focus-width) solid var(--sig);
	}
	.show {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 14px;
		cursor: pointer;
	}
	.show input {
		width: 18px;
		height: 18px;
		margin: 0;
		accent-color: var(--sig-fill);
	}
	/* Always-shown apps: grey, never faded. */
	.show:has(input:disabled) {
		color: var(--comment);
		cursor: not-allowed;
	}
	.actions {
		display: flex;
		gap: var(--space-3);
		position: sticky;
		bottom: 0;
		padding: var(--space-3) 0 calc(var(--space-3) + env(safe-area-inset-bottom));
		background: var(--page);
		border-top: var(--hairline) solid var(--line);
	}
</style>
