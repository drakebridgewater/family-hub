# Copy to .env and fill in. Never commit .env.

SITE_HOST=social.example.com
TZ=America/Chicago
PUID=99
PGID=100

# Where volumes live on Unraid, and where the ./site folder is (for the build)
APPDATA=/mnt/user/appdata/family-hub
BUILD_CONTEXT=./site

# Generate with:  docker run --rm family-hub:latest npx emdash secrets generate
#   (or locally: cd site && npx emdash secrets generate)
# Format: emdash_enc_v1_<43 chars>. Back it up; losing it loses encrypted plugin secrets.
EMDASH_ENCRYPTION_KEY=

# --- Traefik: match your existing setup ---
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
AUTHELIA_MIDDLEWARE=authelia@docker

# --- Authelia ---
# The container must reach Authelia directly (same docker network)
AUTHELIA_INTERNAL_URL=http://authelia:9091
AUTHELIA_PUBLIC_URL=https://auth.example.com
AUTHELIA_SESSION_COOKIE=authelia_session

# --- Family schedule (iCal feeds, comma-separated "Label|URL") ---
# Google Calendar: Settings > your calendar > "Secret address in iCal format"
CALENDAR_FEEDS=
# members = only signed-in users see it (recommended); public = everyone
SCHEDULE_VISIBILITY=members
CALENDAR_DAYS_AHEAD=21

HOMEPAGE_GROUP=Family
